{% extends "base.html.j2" %}

{% block title %}Performance · SPATHI Benchmarks{% endblock %}
{% block kicker %}FORMAL COMPUTATIONAL PERFORMANCE{% endblock %}
{% block heading %}How do runtime, memory, and parallel scaling compare?{% endblock %}
{% block lead %}Fresh, isolated ANDREA executions on identical synthetic inputs, with frozen CPU affinity, warm-ups excluded, full outputs retained, and explicitly bounded container-memory telemetry.{% endblock %}

{% block content %}
  <section class="section" aria-labelledby="evidence-heading">
    <div class="section-heading section-heading--split">
      <div><p class="section-kicker">Evidence base</p><h2 id="evidence-heading">Datasets and protocol</h2></div>
      <p class="section-help">This is computational evidence only. It neither selects configurations nor contributes to the accuracy ranking.</p>
    </div>
    <div id="dataset-cards" class="stat-grid"></div>
    <div id="protocol" class="card"></div>
  </section>

  <section class="section section--overview" aria-labelledby="overview-heading">
    <div class="section-heading"><div><p class="section-kicker">Completion</p><h2 id="overview-heading">Study at a glance</h2></div></div>
    <div id="overview-cards" class="stat-grid"></div>
    <div id="completion-notice"></div>
  </section>

  <section class="section" aria-labelledby="scaling-heading">
    <div class="section-heading section-heading--split">
      <div><p class="section-kicker">Parallel scaling</p><h2 id="scaling-heading">Runtime, speedup, and efficiency</h2></div>
      <p class="section-help">Lines identify method–dataset pairs. Speedup is median one-thread wall time divided by median endpoint wall time, and is shown only after canonical network equality across every thread endpoint and system repetition. The dashed line is ideal scaling.</p>
    </div>
    <div class="chart-grid chart-grid--two">
      <section class="card chart-card"><h3>Median wall time</h3><div id="runtime-chart" class="plot" role="img" aria-label="Median wall time by thread count"></div></section>
      <section class="card chart-card"><h3>Speedup versus one thread</h3><div id="speedup-chart" class="plot" role="img" aria-label="Speedup by thread count"></div></section>
      <section class="card chart-card"><h3>Parallel efficiency</h3><div id="efficiency-chart" class="plot" role="img" aria-label="Parallel efficiency by thread count"></div></section>
      <section class="card chart-card"><h3>Container-memory overlap upper bound</h3><div id="memory-chart" class="plot" role="img" aria-label="Maximum overlap upper bound from physical-container memory peaks by thread count"></div></section>
    </div>
    <div id="memory-notice"></div>
  </section>

  <section class="section" aria-labelledby="audit-heading">
    <div class="section-heading section-heading--split">
      <div><p class="section-kicker">Audit</p><h2 id="audit-heading">Completion, OOM, and semantic equivalence</h2></div>
      <p class="section-help">Equivalence compares canonical normalized networks across thread endpoints and system repetitions. An incomplete condition is reported as unavailable, never as equivalent.</p>
    </div>
    <div id="equivalence-table" class="card table-wrap"></div>
    <div id="measurement-actions"></div>
    <div id="measurement-table" class="card table-wrap"></div>
    <div id="io-notice"></div>
  </section>

  <section class="section" aria-labelledby="provenance-heading">
    <div class="section-heading"><div><p class="section-kicker">Traceability</p><h2 id="provenance-heading">Host, resources, and artifacts</h2></div></div>
    <div class="provenance-grid"><div id="environment" class="card"></div><div id="report-links" class="card"></div></div>
    <div id="study-notes" class="card"></div>
  </section>
{% endblock %}

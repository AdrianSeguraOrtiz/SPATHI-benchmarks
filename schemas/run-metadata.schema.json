{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/run-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "configuration_id",
          "selection_role",
          "algorithm_seed",
          "algorithm_seed_parameter"
        ],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "configuration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "selection_role": {
            "enum": ["baseline", "smoke", "candidate", "selected", "ablation", "reference"]
          },
          "algorithm_seed": {"type": ["integer", "null"], "minimum": 0},
          "algorithm_seed_parameter": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"}
            ]
          },
          "family": {"type": "string", "minLength": 1},
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"algorithm_seed": {"type": "null"}}},
            "then": {"properties": {"algorithm_seed_parameter": {"type": "null"}}},
            "else": {"properties": {"algorithm_seed_parameter": {"type": "string"}}}
          }
        ]
      }
    }
  }
}

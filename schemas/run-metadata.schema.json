{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/run-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "configuration_id",
          "selection_role",
          "algorithm_seed",
          "algorithm_seed_parameter"
        ],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "configuration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selection_role": {
            "enum": ["baseline", "smoke", "base", "candidate", "selected", "ablation"]
          },
          "algorithm_seed": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 2147483646
          },
          "algorithm_seed_parameter": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"}
            ]
          },
          "seed_derivation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "stream", "coordinates"],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^(?:smoke\\.smoke|(?:reduced|full)\\.(?:development|validation|test|scalability|dimensional_transfer|performance))$"
              },
              "stream": {"const": "inference"},
              "coordinates": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {"type": "integer"},
                    {"type": "boolean"}
                  ]
                }
              }
            }
          },
          "family": {"type": "string", "minLength": 1},
          "calibration_fidelity": {"enum": ["scout", "confirmation", "final"]},
          "target_scope": {
            "oneOf": [
              {"const": {"method": "all"}},
              {"const": {"method": "sha256_gene_id", "size": 256, "salt": "spathi-calibration-high-tf-v1"}}
            ]
          },
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"algorithm_seed": {"type": "null"}}},
            "then": {
              "properties": {"algorithm_seed_parameter": {"type": "null"}},
              "not": {"required": ["seed_derivation"]}
            },
            "else": {
              "properties": {"algorithm_seed_parameter": {"type": "string"}},
              "required": ["seed_derivation"]
            }
          }
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/noninferiority-study.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "purpose", "phases", "reference", "analysis", "budgets", "validation_components"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "status": {"const": "planned"},
    "purpose": {"type": "string", "minLength": 1},
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_predeclaration", "efficiency_development", "efficiency_validation"],
      "properties": {
        "policy_predeclaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "timing", "uses_outcome_data", "purpose"],
          "properties": {
            "source": {"const": "committed_study_specification"},
            "timing": {"const": "before_efficiency_validation"},
            "uses_outcome_data": {"const": false},
            "purpose": {"type": "string", "minLength": 1}
          }
        },
        "efficiency_development": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_role", "split_id_by_budget", "purpose", "input", "study_phase"],
          "properties": {
            "dataset_role": {"const": "efficiency_development"},
            "split_id_by_budget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reduced", "full"],
              "properties": {
                "reduced": {"const": "efficiency_development_reduced_v1"},
                "full": {"const": "efficiency_development_full_v1"}
              }
            },
            "purpose": {"type": "string", "minLength": 1},
            "input": {"const": "experiments/v1/spathi/efficiency-development.json"},
            "study_phase": {"const": "efficiency_development"}
          }
        },
        "efficiency_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_role", "split_id", "purpose", "input", "study_phase"],
          "properties": {
            "dataset_role": {"const": "efficiency_validation"},
            "split_id": {"const": "efficiency_validation_v1"},
            "purpose": {"type": "string", "minLength": 1},
            "input": {"const": "content_addressed_efficiency_development_selection"},
            "study_phase": {"const": "efficiency_validation"}
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "required_phase", "role", "required_execution_parameters"],
      "properties": {
        "source": {"const": "completed_calibration_selected_config"},
        "required_phase": {"const": "frozen"},
        "role": {"const": "fixed_exact_reference"},
        "required_execution_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_eligibility", "adaptive_trees"],
          "properties": {
            "target_eligibility": {"const": "all"},
            "adaptive_trees": {"const": false}
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_phase", "validation_dataset_role", "metric", "level", "direction",
        "primary_target_universe", "omitted_target_prediction_policy",
        "absolute_noninferiority_margin", "margin_rationale", "margin_basis", "claim_scope",
        "familywise_alpha", "multiplicity", "multiplicity_rationale", "candidate_decision", "confidence_interval_method",
        "bootstrap_strata", "independent_unit", "algorithm_seed_treatment",
        "context_aggregation", "bootstrap_resamples", "aggregation", "operational_budget_policy",
        "design_sensitivity_contract",
        "runtime_gate", "completion_gate", "reported_cost_endpoints", "adoption_rule"
      ],
      "properties": {
        "study_phase": {"const": "efficiency_validation"},
        "validation_dataset_role": {"const": "efficiency_validation"},
        "metric": {"const": "aupr"},
        "level": {"const": "directed"},
        "direction": {"const": "higher_is_better"},
        "primary_target_universe": {"const": "full_requested_target_universe"},
        "omitted_target_prediction_policy": {"const": "minimum_score_zero"},
        "absolute_noninferiority_margin": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
        "margin_rationale": {"type": "string", "minLength": 1},
        "margin_basis": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "unit", "value", "frozen_before_efficiency_outcomes", "evidence_strength"],
          "properties": {
            "type": {"const": "author_defined_engineering_smallest_effect_of_interest"},
            "unit": {"const": "absolute_aupr"},
            "value": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
            "frozen_before_efficiency_outcomes": {"const": true},
            "evidence_strength": {"const": "judgement_not_empirically_validated"}
          }
        },
        "claim_scope": {"const": "conditional_to_predeclared_synthetic_panel_and_fixed_algorithm_seed_ensemble"},
        "familywise_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
        "multiplicity": {"const": "single_hypothesis_no_adjustment"},
        "multiplicity_rationale": {"type": "string", "minLength": 1},
        "candidate_decision": {"const": "accuracy_coverage_completion_and_runtime_gates"},
        "confidence_interval_method": {"const": "one_sided_percentile_fixed_strata_hierarchical_bootstrap"},
        "bootstrap_strata": {"const": ["simulator_id", "condition_id"]},
        "independent_unit": {"const": "independently_simulated_dataset"},
        "algorithm_seed_treatment": {"const": "fixed_predeclared_ensemble_mean_within_independent_dataset"},
        "context_aggregation": {"const": "equal_weight_mean_within_dataset"},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000, "maximum": 1000000},
        "aggregation": {"const": "equal_simulator_equal_condition_equal_dataset"},
        "operational_budget_policy": {"const": "descriptive_only_without_confidence_intervals_or_gate_decisions"},
        "design_sensitivity_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "interpretation"],
          "properties": {
            "path": {"const": "experiments/v1/spathi/efficiency-design-sensitivity.json"},
            "interpretation": {"const": "prospective_assumption_conditional_operating_characteristics_not_an_empirical_power_guarantee"}
          }
        },
        "runtime_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["estimand", "maximum_one_sided_upper_confidence_bound", "rationale"],
          "properties": {
            "estimand": {"const": "hierarchical_geometric_mean_candidate_over_reference_wall_time_ratio"},
            "maximum_one_sided_upper_confidence_bound": {"const": 1.0},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "completion_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_run_completion_fraction", "minimum_model_completion_fraction", "rationale"],
          "properties": {
            "minimum_run_completion_fraction": {"const": 1.0},
            "minimum_model_completion_fraction": {"const": 1.0},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "reported_cost_endpoints": {
          "const": ["wall_time_seconds", "peak_memory_bytes", "output_bytes", "targets_processed", "models_requested", "trees_fitted"]
        },
        "adoption_rule": {"const": "lowest_geometric_mean_runtime_ratio_then_candidate_id_among_adoptable"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduced", "full"],
      "properties": {
        "reduced": {
          "allOf": [
            {"$ref": "#/$defs/budget"},
            {"properties": {"analysis_role": {"const": "descriptive"}}}
          ]
        },
        "full": {
          "allOf": [
            {"$ref": "#/$defs/budget"},
            {"properties": {"analysis_role": {"const": "confirmatory"}}}
          ]
        }
      }
    },
    "validation_components": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/validation_component"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_role",
        "algorithm_seeds",
        "execution_order_seed",
        "expected_independent_datasets",
        "replicates_per_stratum"
      ],
      "properties": {
        "analysis_role": {"enum": ["descriptive", "confirmatory"]},
        "algorithm_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 2147483646}},
        "execution_order_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "statistical_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "expected_independent_datasets": {"type": "integer", "minimum": 2},
        "replicates_per_stratum": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"analysis_role": {"const": "confirmatory"}}, "required": ["analysis_role"]},
          "then": {"required": ["statistical_seed"]},
          "else": {"not": {"required": ["statistical_seed"]}}
        }
      ]
    },
    "coverage_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_target_fraction", "minimum_truth_edge_fraction",
        "minimum_each_dataset_target_fraction", "minimum_each_dataset_truth_edge_fraction",
        "minimum_each_condition_mean_target_fraction", "minimum_each_condition_mean_truth_edge_fraction",
        "threshold_basis", "rationale"
      ],
      "properties": {
        "minimum_target_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_truth_edge_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_each_dataset_target_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_each_dataset_truth_edge_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_each_condition_mean_target_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_each_condition_mean_truth_edge_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "threshold_basis": {"const": "author_defined_engineering_guardrail_not_validated_for_unobserved_real_truth"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "api", "parameters"],
      "properties": {
        "status": {"const": "bound"},
        "api": {"const": "spathi.SpathiConfig"},
        "parameters": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": [
            "target_eligibility", "min_target_detected_cells", "min_target_detected_fraction",
            "min_target_weighted_detected_fraction", "min_target_weighted_detected_ess",
            "adaptive_trees", "adaptive_min_estimators", "adaptive_tree_step",
            "adaptive_tolerance", "adaptive_patience"
          ]}
        }
      }
    },
    "target_eligibility_overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_eligibility", "min_target_detected_cells", "min_target_detected_fraction", "min_target_weighted_detected_fraction", "min_target_weighted_detected_ess"],
      "properties": {
        "target_eligibility": {"const": "automatic"},
        "min_target_detected_cells": {"type": "integer", "minimum": 1},
        "min_target_detected_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_target_weighted_detected_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_target_weighted_detected_ess": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "adaptive_tree_overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptive_trees", "adaptive_min_estimators", "adaptive_tree_step", "adaptive_tolerance", "adaptive_patience"],
      "properties": {
        "adaptive_trees": {"const": true},
        "adaptive_min_estimators": {"type": "integer", "minimum": 1},
        "adaptive_tree_step": {"type": "integer", "minimum": 1},
        "adaptive_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "adaptive_patience": {"type": "integer", "minimum": 1}
      }
    },
    "combined_overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_eligibility", "min_target_detected_cells", "min_target_detected_fraction",
        "min_target_weighted_detected_fraction", "min_target_weighted_detected_ess",
        "adaptive_trees", "adaptive_min_estimators", "adaptive_tree_step",
        "adaptive_tolerance", "adaptive_patience"
      ],
      "properties": {
        "target_eligibility": {"const": "automatic"},
        "min_target_detected_cells": {"type": "integer", "minimum": 1},
        "min_target_detected_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_target_weighted_detected_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_target_weighted_detected_ess": {"type": "number", "exclusiveMinimum": 0},
        "adaptive_trees": {"const": true},
        "adaptive_min_estimators": {"type": "integer", "minimum": 1},
        "adaptive_tree_step": {"type": "integer", "minimum": 1},
        "adaptive_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "adaptive_patience": {"type": "integer", "minimum": 1}
      }
    },
    "validation_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rationale", "component", "origin", "primary_evaluation_policy", "intersection_diagnostic", "binding"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rationale": {"type": "string", "minLength": 1},
        "component": {"enum": ["target_eligibility", "adaptive_trees", "combined"]},
        "origin": {"const": "selected_from_efficiency_development"},
        "primary_evaluation_policy": {"const": "full_requested_universe"},
        "intersection_diagnostic": {"type": "boolean"},
        "coverage_gates": {"$ref": "#/$defs/coverage_gates"},
        "binding": {"$ref": "#/$defs/binding"}
      },
      "allOf": [
        {
          "if": {"properties": {"component": {"const": "target_eligibility"}}, "required": ["component"]},
          "then": {"required": ["coverage_gates"], "properties": {"intersection_diagnostic": {"const": true}}}
        },
        {
          "if": {"properties": {"component": {"const": "adaptive_trees"}}, "required": ["component"]},
          "then": {"not": {"required": ["coverage_gates"]}, "properties": {"intersection_diagnostic": {"const": false}}}
        },
        {
          "if": {"properties": {"component": {"const": "combined"}}, "required": ["component"]},
          "then": {"required": ["coverage_gates"], "properties": {"intersection_diagnostic": {"const": true}}}
        }
      ]
    }
  }
}

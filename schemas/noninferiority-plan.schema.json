{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/noninferiority-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "study_phase",
    "study",
    "design_sensitivity",
    "development_selection",
    "panel",
    "budget",
    "reference",
    "analysis",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_efficiency_noninferiority_plan"},
    "study_phase": {"const": "efficiency_validation"},
    "study": {"$ref": "#/$defs/file_reference"},
    "design_sensitivity": {"$ref": "#/$defs/file_reference"},
    "development_selection": {"$ref": "#/$defs/file_reference"},
    "panel": {"$ref": "#/$defs/file_reference"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "analysis_role",
        "algorithm_seeds",
        "execution_order_seed",
        "expected_independent_datasets",
        "replicates_per_stratum"
      ],
      "properties": {
        "id": {"enum": ["reduced", "full"]},
        "analysis_role": {"enum": ["descriptive", "confirmatory"]},
        "algorithm_seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 2147483646}
        },
        "execution_order_seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "statistical_seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "expected_independent_datasets": {"type": "integer", "minimum": 2},
        "replicates_per_stratum": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "full"}}, "required": ["id"]},
          "then": {
            "required": ["statistical_seed"],
            "properties": {"analysis_role": {"const": "confirmatory"}}
          },
          "else": {
            "properties": {"analysis_role": {"const": "descriptive"}},
            "not": {"required": ["statistical_seed"]}
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_config",
        "policy_id",
        "policy_sha256",
        "group_policy",
        "source_candidate_id",
        "source_configuration_sha256",
        "spathi_commit",
        "spathi_build_fingerprint",
        "spathi_image_id",
        "selection_validation_manifest_sha256"
      ],
      "properties": {
        "selected_config": {"$ref": "#/$defs/file_reference"},
        "policy_id": {"$ref": "#/$defs/id"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "group_policy": {"$ref": "#/$defs/group_policy"},
        "source_candidate_id": {"$ref": "#/$defs/id"},
        "source_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "spathi_build_fingerprint": {"$ref": "#/$defs/sha256"},
        "spathi_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "selection_validation_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "analysis": {"type": "object"},
    "candidates": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rationale",
          "component",
          "origin",
          "validation_component_id",
          "primary_evaluation_policy",
          "intersection_diagnostic",
          "execution_overrides",
          "execution_overrides_sha256",
          "development_candidate_sha256",
          "development_result",
          "group_policy",
          "policy_sha256",
          "binding"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "rationale": {"type": "string", "minLength": 1},
          "component": {
            "enum": ["target_eligibility", "adaptive_trees", "combined"]
          },
          "origin": {"const": "selected_from_efficiency_development"},
          "validation_component_id": {"$ref": "#/$defs/id"},
          "primary_evaluation_policy": {"const": "full_requested_universe"},
          "intersection_diagnostic": {"type": "boolean"},
          "execution_overrides": {"type": "object", "minProperties": 1},
          "execution_overrides_sha256": {"$ref": "#/$defs/sha256"},
          "development_candidate_sha256": {"$ref": "#/$defs/sha256"},
          "development_result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id", "component", "mean_aupr_loss", "wall_time_ratio",
              "complete", "accuracy_eligible", "dataset_count", "accuracy_seed_count",
              "timing_seed_count"
            ],
            "properties": {
              "candidate_id": {"$ref": "#/$defs/id"},
              "component": {"enum": ["target_eligibility", "adaptive_trees", "combined"]},
              "mean_aupr_loss": {"type": "number"},
              "wall_time_ratio": {"type": "number", "exclusiveMinimum": 0},
              "complete": {"const": true},
              "accuracy_eligible": {"const": true},
              "dataset_count": {"type": "integer", "minimum": 1},
              "accuracy_seed_count": {"type": "integer", "minimum": 1, "maximum": 2},
              "timing_seed_count": {"const": 1}
            }
          },
          "group_policy": {"$ref": "#/$defs/group_policy"},
          "policy_sha256": {"$ref": "#/$defs/sha256"},
          "coverage_gates": {"type": "object"},
          "binding": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "file_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "parameters"],
      "properties": {
        "condition": {"type": "object", "minProperties": 1},
        "parameters": {"type": "object", "minProperties": 1}
      }
    },
    "group_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_parameter", "shared_parameters", "branches"],
      "properties": {
        "routing_parameter": {"const": "group_count"},
        "shared_parameters": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "branches": {
          "type": "object", "additionalProperties": false,
          "required": ["single_group", "multi_group"],
          "properties": {
            "single_group": {"$ref": "#/$defs/policy_branch"},
            "multi_group": {"$ref": "#/$defs/policy_branch"}
          }
        }
      }
    }
  }
}

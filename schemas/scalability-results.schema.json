{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/scalability-results.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "budget",
    "evidence_role",
    "claim_scope",
    "status",
    "expression_preparation",
    "resource_boundary",
    "profile",
    "selected_config",
    "execution_environment",
    "summary",
    "datasets",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_scalability_results"},
    "budget": {"enum": ["reduced", "full"]},
    "evidence_role": {"enum": ["operational", "publication"]},
    "claim_scope": {"const": "computational_scale_stress_only"},
    "status": {"const": "complete"},
    "expression_preparation": {"$ref": "#/$defs/expression_preparation"},
    "resource_boundary": {"$ref": "#/$defs/resource_boundary"},
    "profile": {"$ref": "#/$defs/artifact"},
    "selected_config": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "required": ["policy_id", "policy_sha256"],
          "properties": {
            "policy_id": {"$ref": "#/$defs/id"},
            "policy_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spathi_commit",
        "andrea_commit",
        "spathi_image_id",
        "andrea_environment_fingerprint",
        "benchmark_environment_fingerprint",
        "docker_runtime_environment_fingerprint",
        "system",
        "kernel_release",
        "machine",
        "cpu_model",
        "logical_cpus",
        "host_memory_bytes",
        "cpu_threads",
        "memory_bytes",
        "memory_gib",
        "cpuset_cpus",
        "planner",
        "planner_time_limit_seconds",
        "output_profile",
        "exclusive_inference",
        "execution_plan_fingerprint",
        "measurement_contract"
      ],
      "properties": {
        "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "andrea_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "spathi_image_id": {"type": "string", "minLength": 1},
        "andrea_environment_fingerprint": {"$ref": "#/$defs/sha256"},
        "benchmark_environment_fingerprint": {"$ref": "#/$defs/sha256"},
        "docker_runtime_environment_fingerprint": {"$ref": "#/$defs/sha256"},
        "system": {"type": "string", "minLength": 1},
        "kernel_release": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "logical_cpus": {"type": "integer", "minimum": 1},
        "host_memory_bytes": {"type": "integer", "minimum": 1},
        "cpu_threads": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1073741824},
        "memory_gib": {"type": "number", "minimum": 1},
        "cpuset_cpus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "planner": {"enum": ["auto", "heuristic", "cp_sat"]},
        "planner_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "output_profile": {"enum": ["canonical", "full"]},
        "exclusive_inference": {"const": true},
        "execution_plan_fingerprint": {"$ref": "#/$defs/sha256"},
        "measurement_contract": {"const": "andrea_container_telemetry_v1"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasets_requested",
        "datasets_completed",
        "datasets_failed",
        "datasets_not_attempted",
        "all_completed",
        "scouts_attempted",
        "scouts_completed",
        "all_targets_attempted",
        "all_targets_completed",
        "failure_kinds",
        "total_generation_wall_time_seconds",
        "total_inference_wall_time_seconds",
        "attempts_with_peak_memory",
        "maximum_peak_memory_bytes",
        "total_spathi_output_bytes",
        "total_trees_fitted"
      ],
      "properties": {
        "datasets_requested": {"type": "integer", "minimum": 1},
        "datasets_completed": {"type": "integer", "minimum": 0},
        "datasets_failed": {"type": "integer", "minimum": 0},
        "datasets_not_attempted": {"type": "integer", "minimum": 0},
        "all_completed": {"type": "boolean"},
        "scouts_attempted": {"type": "integer", "minimum": 0},
        "scouts_completed": {"type": "integer", "minimum": 0},
        "all_targets_attempted": {"type": "integer", "minimum": 0},
        "all_targets_completed": {"type": "integer", "minimum": 0},
        "failure_kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oom", "timeout", "tool_error", "infrastructure_error"],
          "properties": {
            "oom": {"type": "integer", "minimum": 0},
            "timeout": {"type": "integer", "minimum": 0},
            "tool_error": {"type": "integer", "minimum": 0},
            "infrastructure_error": {"type": "integer", "minimum": 0}
          }
        },
        "total_generation_wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "total_inference_wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "attempts_with_peak_memory": {"type": "integer", "minimum": 0},
        "maximum_peak_memory_bytes": {"type": "integer", "minimum": 0},
        "total_spathi_output_bytes": {"type": "integer", "minimum": 0},
        "total_trees_fitted": {"type": "integer", "minimum": 0}
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dataset"}
    },
    "notes": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"budget": {"const": "full"}}, "required": ["budget"]},
      "then": {
        "properties": {
          "evidence_role": {"const": "publication"},
          "resource_boundary": {
            "properties": {
              "target_scout_size": {"const": 128},
              "prospective_wall_time_limit_seconds": {"const": 86400}
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence_role": {"const": "operational"},
          "resource_boundary": {
            "properties": {
              "target_scout_size": {"const": 64},
              "prospective_wall_time_limit_seconds": {"const": 43200}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "nonnegative_number": {
      "type": "number",
      "minimum": 0
    },
    "expression_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_scale",
        "normalization",
        "target_sum",
        "library_size_scope",
        "formula"
      ],
      "properties": {
        "input_scale": {"const": "nonnegative_synthetic_counts_like"},
        "normalization": {"const": "library-size-log1p"},
        "target_sum": {"const": 10000.0},
        "library_size_scope": {"const": "all_generated_genes_before_any_filtering"},
        "formula": {
          "const": "log1p(target_sum * raw_value / per_cell_library_size)"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "policy_id": {"$ref": "#/$defs/id"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resource_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "id",
        "target_scout_size",
        "wall_time_measurement",
        "prospective_wall_time_limit_seconds",
        "maximum_projected_wall_time_fraction",
        "maximum_observed_memory_fraction"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "id": {"const": "spathi_scalability_boundary_v1"},
        "target_scout_size": {"enum": [64, 128]},
        "wall_time_measurement": {"const": "andrea_execution.wall_time_seconds"},
        "prospective_wall_time_limit_seconds": {"enum": [43200, 86400]},
        "maximum_projected_wall_time_fraction": {"const": 0.8},
        "maximum_observed_memory_fraction": {"const": 0.8}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells", "genes", "groups", "transcription_factors", "targets"],
      "properties": {
        "cells": {"type": "integer", "minimum": 1},
        "genes": {"type": "integer", "minimum": 10},
        "groups": {"type": "integer", "minimum": 1},
        "transcription_factors": {"type": "integer", "minimum": 2},
        "targets": {"type": "integer", "minimum": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "cache_hit",
        "dataset_artifact_bytes",
        "expression_bytes"
      ],
      "properties": {
        "wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "cache_hit": {"type": "boolean"},
        "dataset_artifact_bytes": {"type": "integer", "minimum": 1},
        "expression_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "execution_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_threads",
        "memory_bytes",
        "memory_gib",
        "cpuset_cpus",
        "planner",
        "planner_time_limit_seconds",
        "output_profile",
        "exclusive",
        "execution_plan_fingerprint",
        "timeout_seconds"
      ],
      "properties": {
        "cpu_threads": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1073741824},
        "memory_gib": {"type": "number", "minimum": 1},
        "cpuset_cpus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "planner": {"enum": ["auto", "heuristic", "cp_sat"]},
        "planner_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "output_profile": {"enum": ["canonical", "full"]},
        "exclusive": {"const": true},
        "execution_plan_fingerprint": {"$ref": "#/$defs/sha256"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "target_scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {"method": {"const": "all"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "size", "salt", "dataset_id"],
          "properties": {
            "method": {"const": "sha256_gene_id"},
            "size": {"enum": [64, 128]},
            "salt": {"const": "spathi-scalability-scout-v1"},
            "dataset_id": {"$ref": "#/$defs/id"}
          }
        }
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spathi_wall_time_seconds",
        "andrea_measurement",
        "andrea_execution_measurement",
        "cache_hit",
        "inference_artifact_bytes",
        "spathi_output_bytes",
        "targets_requested",
        "models_requested",
        "models_completed",
        "models_trained",
        "models_failed",
        "trees_fitted",
        "threads_requested",
        "threads_effective",
        "threads_available",
        "estimated_peak_heap_with_rough_trees_bytes"
      ],
      "properties": {
        "spathi_wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "andrea_measurement": {"$ref": "#/$defs/andrea_measurement"},
        "andrea_execution_measurement": {"$ref": "#/$defs/andrea_execution_measurement"},
        "cache_hit": {"const": false},
        "inference_artifact_bytes": {"type": "integer", "minimum": 1},
        "spathi_output_bytes": {"type": "integer", "minimum": 1},
        "targets_requested": {"type": "integer", "minimum": 1},
        "models_requested": {"type": "integer", "minimum": 0},
        "models_completed": {"type": "integer", "minimum": 0},
        "models_trained": {"type": "integer", "minimum": 0},
        "models_failed": {"type": "integer", "minimum": 0},
        "trees_fitted": {"type": "integer", "minimum": 0},
        "threads_requested": {"type": "integer", "minimum": 1},
        "threads_effective": {"type": "integer", "minimum": 1},
        "threads_available": {"type": "integer", "minimum": 1},
        "estimated_peak_heap_with_rough_trees_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "seed_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "stream", "coordinates"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^(?:reduced|full)\\.scalability$"},
        "stream": {"const": "inference"},
        "coordinates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "integer"},
              {"type": "boolean"}
            ]
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_kind",
        "stage",
        "message",
        "orchestrator_exit_code",
        "tool_exit_code"
      ],
      "properties": {
        "failure_kind": {
          "enum": ["oom", "timeout", "tool_error", "infrastructure_error"]
        },
        "stage": {"const": "inference"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "orchestrator_exit_code": {"type": "integer"},
        "tool_exit_code": {"type": "integer"}
      }
    },
    "failure_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "andrea_measurement",
        "andrea_execution_measurement"
      ],
      "properties": {
        "andrea_measurement": {"$ref": "#/$defs/andrea_measurement"},
        "andrea_execution_measurement": {"$ref": "#/$defs/andrea_execution_measurement"}
      }
    },
    "nullable_nonnegative_number": {
      "oneOf": [
        {"$ref": "#/$defs/nonnegative_number"},
        {"type": "null"}
      ]
    },
    "nullable_nonnegative_integer": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "nullable_timestamp": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "nullable_cpuset": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        {"type": "null"}
      ]
    },
    "andrea_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "wall_time_seconds",
        "container_wall_time_seconds",
        "cpu_time_seconds",
        "peak_memory_bytes",
        "output_bytes",
        "io_read_bytes",
        "io_write_bytes",
        "task_started_at_utc",
        "task_finished_at_utc",
        "task_started_monotonic_ns",
        "task_finished_monotonic_ns",
        "container_started_at_utc",
        "container_finished_at_utc",
        "assigned_resources",
        "telemetry"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scope": {"const": "physical_task"},
        "wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "container_wall_time_seconds": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "cpu_time_seconds": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "peak_memory_bytes": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_bytes": {"type": "integer", "minimum": 0},
        "io_read_bytes": {"type": "null"},
        "io_write_bytes": {"type": "null"},
        "task_started_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "task_finished_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "task_started_monotonic_ns": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "task_finished_monotonic_ns": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "container_started_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "container_finished_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "assigned_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threads",
            "ram_limit_bytes",
            "cpuset_cpus_requested",
            "cpuset_cpus_configured",
            "cpuset_cpus_effective",
            "cpu_quota_cores_effective",
            "ram_limit_bytes_effective"
          ],
          "properties": {
            "threads": {"type": "integer", "minimum": 1},
            "ram_limit_bytes": {"type": "integer", "minimum": 1073741824},
            "cpuset_cpus_requested": {"$ref": "#/$defs/nullable_cpuset"},
            "cpuset_cpus_configured": {"$ref": "#/$defs/nullable_cpuset"},
            "cpuset_cpus_effective": {"$ref": "#/$defs/nullable_cpuset"},
            "cpu_quota_cores_effective": {"$ref": "#/$defs/nullable_nonnegative_number"},
            "ram_limit_bytes_effective": {"$ref": "#/$defs/nullable_nonnegative_integer"}
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "wall_source",
            "wall_semantics",
            "container_wall_source",
            "cpu_source",
            "memory_source",
            "memory_semantics",
            "io_source",
            "io_semantics",
            "throttled_time_seconds",
            "oom_events",
            "oom_kill_events",
            "memory_limit_events",
            "oom_killed"
          ],
          "properties": {
            "status": {"enum": ["complete", "partial", "unavailable", "not_started"]},
            "wall_source": {"type": ["string", "null"]},
            "wall_semantics": {"type": "string", "minLength": 1},
            "container_wall_source": {"type": ["string", "null"]},
            "cpu_source": {"type": ["string", "null"]},
            "memory_source": {"type": ["string", "null"]},
            "memory_semantics": {"type": "string", "minLength": 1},
            "io_source": {"type": "null"},
            "io_semantics": {"const": "unavailable"},
            "throttled_time_seconds": {"$ref": "#/$defs/nullable_nonnegative_number"},
            "oom_events": {"$ref": "#/$defs/nullable_nonnegative_integer"},
            "oom_kill_events": {"$ref": "#/$defs/nullable_nonnegative_integer"},
            "memory_limit_events": {"$ref": "#/$defs/nullable_nonnegative_integer"},
            "oom_killed": {"type": "boolean"}
          }
        }
      }
    },
    "andrea_execution_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "wall_time_seconds",
        "child_wall_time_sum_seconds",
        "postprocess_wall_time_seconds",
        "cpu_time_seconds",
        "peak_memory_bytes",
        "output_bytes",
        "io_read_bytes",
        "io_write_bytes",
        "task_started_at_utc",
        "task_finished_at_utc",
        "task_started_monotonic_ns",
        "task_finished_monotonic_ns",
        "assigned_resources",
        "telemetry"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scope": {"const": "andrea_execution"},
        "wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "child_wall_time_sum_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "postprocess_wall_time_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "cpu_time_seconds": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "peak_memory_bytes": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_bytes": {"type": "integer", "minimum": 0},
        "io_read_bytes": {"type": "null"},
        "io_write_bytes": {"type": "null"},
        "task_started_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "task_finished_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "task_started_monotonic_ns": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "task_finished_monotonic_ns": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "assigned_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threads_peak",
            "ram_limit_peak_bytes",
            "cpuset_cpus_requested_sets",
            "cpuset_cpus_effective_sets"
          ],
          "properties": {
            "threads_peak": {"type": "integer", "minimum": 0},
            "ram_limit_peak_bytes": {"type": "integer", "minimum": 0},
            "cpuset_cpus_requested_sets": {
              "type": "array",
              "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
            },
            "cpuset_cpus_effective_sets": {
              "type": "array",
              "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "wall_source",
            "wall_semantics",
            "cpu_source",
            "cpu_semantics",
            "memory_source",
            "memory_semantics",
            "io_source",
            "io_semantics"
          ],
          "properties": {
            "status": {"enum": ["complete", "partial", "unavailable"]},
            "wall_source": {"const": "andrea_monotonic_clock"},
            "wall_semantics": {"const": "andrea_execution_end_to_end_including_input_verification_preparation_scheduling_merging_and_requested_output_materialization"},
            "cpu_source": {"const": "sum_of_child_container_cpu"},
            "cpu_semantics": {"const": "sum_of_physical_container_cpu_excludes_andrea_host_process"},
            "memory_source": {"type": ["string", "null"]},
            "memory_semantics": {"enum": ["overlap_upper_bound_from_physical_container_peaks_excludes_andrea_host_process", "unavailable_when_any_child_peak_or_interval_is_unavailable"]},
            "io_source": {"type": "null"},
            "io_semantics": {"const": "unavailable"}
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "status", "phase", "message", "warnings"],
      "properties": {
        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "status": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_log", "progress", "tool_log_tail"],
      "properties": {
        "command_log": {"$ref": "#/$defs/file_artifact"},
        "progress": {
          "oneOf": [
            {"$ref": "#/$defs/progress"},
            {"type": "null"}
          ]
        },
        "tool_log_tail": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 65536},
            {"type": "null"}
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "stage",
        "target_scope",
        "status",
        "network_mode",
        "policy_branch",
        "generation_seed",
        "algorithm_seed",
        "seed_derivation",
        "dimensions",
        "execution_limits",
        "generation",
        "dataset_artifact"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["scout", "all_targets"]},
        "target_scope": {"$ref": "#/$defs/target_scope"},
        "status": {"enum": ["completed", "failed"]},
        "network_mode": {"enum": ["dynamic", "invariant"]},
        "policy_branch": {"enum": ["single_group", "multi_group"]},
        "generation_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "algorithm_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "seed_derivation": {"$ref": "#/$defs/seed_derivation"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "execution_limits": {"$ref": "#/$defs/execution_limits"},
        "generation": {"$ref": "#/$defs/generation"},
        "inference": {"$ref": "#/$defs/inference"},
        "failure": {"$ref": "#/$defs/failure"},
        "observations": {"$ref": "#/$defs/failure_observations"},
        "diagnostics": {"$ref": "#/$defs/diagnostics"},
        "dataset_artifact": {"$ref": "#/$defs/content_artifact"},
        "inference_artifact": {"$ref": "#/$defs/content_artifact"},
        "run_metadata": {"$ref": "#/$defs/artifact"}
      },
      "allOf": [
        {
          "if": {"properties": {"stage": {"const": "scout"}}, "required": ["stage"]},
          "then": {"properties": {"target_scope": {"properties": {"method": {"const": "sha256_gene_id"}}, "required": ["method"]}}},
          "else": {"properties": {"target_scope": {"properties": {"method": {"const": "all"}}, "required": ["method"]}}}
        },
        {
          "if": {
            "properties": {"status": {"const": "completed"}},
            "required": ["status"]
          },
          "then": {
            "required": ["inference", "inference_artifact", "run_metadata"],
            "not": {
              "anyOf": [
                {"required": ["failure"]},
                {"required": ["observations"]},
                {"required": ["diagnostics"]}
              ]
            }
          },
          "else": {
            "required": ["failure", "observations", "diagnostics"],
            "not": {
              "anyOf": [
                {"required": ["inference"]},
                {"required": ["inference_artifact"]},
                {"required": ["run_metadata"]}
              ]
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "lane_id", "stage", "decision", "reason", "evidence_dataset_id"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"},
        "lane_id": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["scout", "all_targets"]},
        "decision": {"enum": ["attempt", "not_attempted_after_preregistered_resource_boundary"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_dataset_id": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "status",
        "network_mode",
        "policy_branch",
        "generation_seed",
        "algorithm_seed",
        "seed_derivation",
        "dimensions",
        "lane_ids",
        "decisions",
        "scout",
        "all_targets"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["completed", "failed", "not_attempted_after_preregistered_resource_boundary"]},
        "network_mode": {"enum": ["dynamic", "invariant"]},
        "policy_branch": {"enum": ["single_group", "multi_group"]},
        "generation_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "algorithm_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "seed_derivation": {"$ref": "#/$defs/seed_derivation"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "lane_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scout", "all_targets"],
          "properties": {
            "scout": {"$ref": "#/$defs/decision"},
            "all_targets": {"$ref": "#/$defs/decision"}
          }
        },
        "scout": {"oneOf": [{"$ref": "#/$defs/attempt"}, {"type": "null"}]},
        "all_targets": {"oneOf": [{"$ref": "#/$defs/attempt"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {"properties": {"all_targets": {"allOf": [{"$ref": "#/$defs/attempt"}, {"properties": {"status": {"const": "completed"}}}]}}}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
          "then": {"properties": {"all_targets": {"allOf": [{"$ref": "#/$defs/attempt"}, {"properties": {"status": {"const": "failed"}}}]}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_attempted_after_preregistered_resource_boundary"}}, "required": ["status"]},
          "then": {"properties": {"all_targets": {"type": "null"}}}
        }
      ]
    },
    "file_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "content_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"enum": ["dataset", "inference"]},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

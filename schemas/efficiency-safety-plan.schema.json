{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/efficiency-safety-plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "study_phase", "study", "source_efficiency", "panel", "budget", "seed_contract", "reference", "analysis", "candidates", "interpretation_limit"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_efficiency_safety_plan"},
    "study_phase": {"const": "efficiency_safety"},
    "study": {"$ref": "#/$defs/file_reference"},
    "source_efficiency": {
      "type": "object", "additionalProperties": false, "required": ["plan", "results", "formal_adoption_sha256"],
      "properties": {"plan": {"$ref": "#/$defs/file_reference"}, "results": {"$ref": "#/$defs/file_reference"}, "formal_adoption_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "panel": {"$ref": "#/$defs/file_reference"},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "analysis_role", "algorithm_seeds", "execution_order_seed", "expected_independent_datasets"],
      "properties": {
        "id": {"const": "full"}, "analysis_role": {"const": "descriptive_safety_veto"},
        "algorithm_seeds": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/seed"}},
        "execution_order_seed": {"$ref": "#/$defs/seed"}, "expected_independent_datasets": {"const": 18}
      }
    },
    "seed_contract": {
      "type": "object", "additionalProperties": false, "required": ["seed_plan", "algorithm_seed", "execution_order_seed"],
      "properties": {"seed_plan": {"$ref": "#/$defs/file_reference"}, "algorithm_seed": {"$ref": "#/$defs/seed_record"}, "execution_order_seed": {"$ref": "#/$defs/seed_record"}}
    },
    "reference": {"$ref": "#/$defs/reference"},
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["validation_dataset_role", "split_id", "metric", "level", "primary_target_universe", "context_aggregation", "independent_unit", "statistical_role", "selection_rule", "condition_scales", "thresholds"],
      "properties": {
        "validation_dataset_role": {"const": "efficiency_safety"}, "split_id": {"const": "efficiency_safety_v1"},
        "metric": {"const": "aupr"}, "level": {"const": "directed"}, "primary_target_universe": {"const": "full_requested_target_universe"},
        "context_aggregation": {"const": "equal_weight_mean_within_dataset"}, "independent_unit": {"const": "independently_simulated_dataset"},
        "statistical_role": {"const": "descriptive_veto_without_confidence_intervals_or_p_values"},
        "selection_rule": {"const": "single_provisional_candidate_no_fallback"},
        "condition_scales": {"$ref": "#/$defs/condition_scales"}, "thresholds": {"$ref": "#/$defs/thresholds"}
      }
    },
    "candidates": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "interpretation_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "file_reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "seed_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "seed_derivation"],
      "properties": {
        "seed": {"$ref": "#/$defs/seed"},
        "seed_derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "stream", "coordinates"],
          "properties": {
            "namespace": {"const": "full.efficiency_safety"},
            "stream": {"enum": ["inference", "execution_order"]},
            "coordinates": {"type": "object", "minProperties": 1}
          }
        }
      }
    },
    "scale": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_job", "simulator", "genes", "transcription_factors", "cells", "group_sizes", "target_list", "scenario", "simulator_runs", "scenario_inputs"],
      "properties": {
        "generation_job": {"$ref": "#/$defs/id"}, "simulator": {"const": "scmultisim"},
        "genes": {"type": "integer", "minimum": 2}, "transcription_factors": {"type": "integer", "minimum": 1}, "cells": {"type": "integer", "minimum": 1},
        "group_sizes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "target_list": {"const": null},
        "scenario": {"$ref": "#/$defs/file_reference"}, "simulator_runs": {"$ref": "#/$defs/file_reference"},
        "scenario_inputs": {"$ref": "#/$defs/scenario_inputs"}
      }
    },
    "scenario_input": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_path", "kind", "files"],
      "properties": {
        "declared_path": {"$ref": "#/$defs/relative_path"},
        "kind": {"const": "file"},
        "files": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/file_reference"}}
      }
    },
    "scenario_inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["regulatory_network", "tree_newick"],
      "properties": {
        "regulatory_network": {"$ref": "#/$defs/scenario_input"},
        "tree_newick": {"$ref": "#/$defs/scenario_input"}
      }
    },
    "condition_scales": {
      "type": "object", "additionalProperties": false,
      "required": ["g3000_tf100_c300", "g3000_tf1500_c300", "g15000_tf100_c300", "g100_tf10_c500_single_group", "g100_tf10_c300_groups_10_40_250", "g100_tf10_c10000"],
      "properties": {
        "g3000_tf100_c300": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 3000}, "transcription_factors": {"const": 100}, "cells": {"const": 300}, "group_sizes": {"const": [100, 100, 100]}}}]},
        "g3000_tf1500_c300": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 3000}, "transcription_factors": {"const": 1500}, "cells": {"const": 300}, "group_sizes": {"const": [100, 100, 100]}}}]},
        "g15000_tf100_c300": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 15000}, "transcription_factors": {"const": 100}, "cells": {"const": 300}, "group_sizes": {"const": [100, 100, 100]}}}]},
        "g100_tf10_c500_single_group": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 100}, "transcription_factors": {"const": 10}, "cells": {"const": 500}, "group_sizes": {"const": [500]}}}]},
        "g100_tf10_c300_groups_10_40_250": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 100}, "transcription_factors": {"const": 10}, "cells": {"const": 300}, "group_sizes": {"const": [10, 40, 250]}}}]},
        "g100_tf10_c10000": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 100}, "transcription_factors": {"const": 10}, "cells": {"const": 10000}, "group_sizes": {"const": [3333, 3333, 3334]}}}]}
      }
    },
    "policy_branch": {"type": "object", "additionalProperties": false, "required": ["condition", "parameters"], "properties": {"condition": {"type": "object", "minProperties": 1}, "parameters": {"type": "object", "minProperties": 1}}},
    "group_policy": {"type": "object", "additionalProperties": false, "required": ["routing_parameter", "shared_parameters", "branches"], "properties": {"routing_parameter": {"const": "group_count"}, "shared_parameters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "branches": {"type": "object", "additionalProperties": false, "required": ["single_group", "multi_group"], "properties": {"single_group": {"$ref": "#/$defs/policy_branch"}, "multi_group": {"$ref": "#/$defs/policy_branch"}}}},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_config", "policy_id", "policy_sha256", "group_policy", "source_candidate_id", "source_configuration_sha256", "spathi_commit", "spathi_build_fingerprint", "spathi_image_id", "selection_validation_manifest_sha256"],
      "properties": {"selected_config": {"$ref": "#/$defs/file_reference"}, "policy_id": {"$ref": "#/$defs/id"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "group_policy": {"$ref": "#/$defs/group_policy"}, "source_candidate_id": {"$ref": "#/$defs/id"}, "source_configuration_sha256": {"$ref": "#/$defs/sha256"}, "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "spathi_build_fingerprint": {"$ref": "#/$defs/sha256"}, "spathi_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "selection_validation_manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "candidate": {
      "type": "object",
      "required": ["id", "rationale", "component", "origin", "primary_evaluation_policy", "intersection_diagnostic", "execution_overrides", "execution_overrides_sha256", "group_policy", "policy_sha256", "binding"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "rationale": {"type": "string", "minLength": 1}, "component": {"enum": ["target_eligibility", "adaptive_trees", "combined"]}, "origin": {"const": "predeclared_in_study"}, "primary_evaluation_policy": {"const": "full_requested_universe"}, "intersection_diagnostic": {"type": "boolean"}, "execution_overrides": {"type": "object", "minProperties": 1}, "execution_overrides_sha256": {"$ref": "#/$defs/sha256"}, "group_policy": {"$ref": "#/$defs/group_policy"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "coverage_gates": {"type": "object"}, "binding": {"type": "object"}}
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_independent_datasets", "expected_conditions", "expected_datasets_per_condition", "minimum_mean_aupr_difference", "minimum_median_aupr_difference", "minimum_each_dataset_aupr_difference", "maximum_median_wall_time_ratio", "minimum_each_dataset_target_fraction", "minimum_each_dataset_truth_edge_fraction", "basis"],
      "properties": {
        "expected_independent_datasets": {"const": 18},
        "expected_conditions": {"const": ["g3000_tf100_c300", "g3000_tf1500_c300", "g15000_tf100_c300", "g100_tf10_c500_single_group", "g100_tf10_c300_groups_10_40_250", "g100_tf10_c10000"]},
        "expected_datasets_per_condition": {"const": 3},
        "minimum_mean_aupr_difference": {"const": -0.002}, "minimum_median_aupr_difference": {"const": -0.002}, "minimum_each_dataset_aupr_difference": {"const": -0.01},
        "maximum_median_wall_time_ratio": {"const": 1.0},
        "minimum_each_dataset_target_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_each_dataset_truth_edge_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
}

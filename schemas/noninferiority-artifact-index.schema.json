{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/noninferiority-artifact-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "plan_sha256",
    "panel_sha256",
    "artifact_store",
    "execution",
    "runs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {
      "enum": [
        "spathi_efficiency_artifact_index",
        "spathi_efficiency_safety_artifact_index"
      ]
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "panel_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_store": {"$ref": "#/$defs/relative_path"},
    "execution": {"$ref": "#/$defs/execution"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "inference_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"const": "inference"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_threads",
        "memory_bytes",
        "memory_gib",
        "planner",
        "planner_time_limit_seconds",
        "output_profile",
        "execution_plan_fingerprint"
      ],
      "properties": {
        "cpu_threads": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1073741824},
        "memory_gib": {"type": "number", "minimum": 1},
        "planner": {"enum": ["auto", "cp_sat", "heuristic"]},
        "planner_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "output_profile": {"enum": ["canonical", "full"]},
        "execution_plan_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "andrea_commit",
        "andrea_environment",
        "benchmark_environment",
        "docker_runtime",
        "spathi_commit",
        "spathi_build_fingerprint",
        "spathi_image_id",
        "execution_order_seed",
        "execution_order_seed_derivation",
        "resources",
        "measurement_protocol",
        "runner_sha256"
      ],
      "properties": {
        "andrea_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "andrea_environment": {"$ref": "#/$defs/sha256"},
        "benchmark_environment": {"$ref": "#/$defs/sha256"},
        "docker_runtime": {"$ref": "#/$defs/sha256"},
        "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "spathi_build_fingerprint": {"$ref": "#/$defs/sha256"},
        "spathi_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_order_seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "execution_order_seed_derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "stream", "coordinates"],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^(?:(?:reduced|full)\\.efficiency_validation|full\\.efficiency_safety)$"
            },
            "stream": {"const": "execution_order"},
            "coordinates": {
              "const": {"purpose": "counterbalanced_execution_order"}
            }
          }
        },
        "resources": {"$ref": "#/$defs/resources"},
        "measurement_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source", "scope", "wall_time", "peak_memory", "output_bytes",
            "telemetry_status", "model_counts", "tree_counts"
          ],
          "properties": {
            "source": {"const": "andrea_execution_measurement"},
            "scope": {"const": "andrea_execution"},
            "wall_time": {"const": "andrea_execution_end_to_end_including_input_verification_preparation_scheduling_merging_and_requested_output_materialization"},
            "peak_memory": {"const": "physical_container_peak_overlap_upper_bound_excluding_andrea_host"},
            "output_bytes": {"const": "andrea_execution_output_tree_at_measurement"},
            "telemetry_status": {"const": "complete_required"},
            "model_counts": {"const": "validated_spathi_run_metadata"},
            "tree_counts": {"const": "validated_spathi_model_diagnostics"}
          }
        },
        "runner_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "inference_artifact"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "inference_artifact": {"$ref": "#/$defs/inference_artifact"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "algorithm_seed",
        "seed_derivation",
        "reference",
        "candidates",
        "execution_order"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"},
        "algorithm_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "seed_derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "stream", "coordinates"],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^(?:(?:reduced|full)\\.efficiency_validation|full\\.efficiency_safety)$"
            },
            "stream": {"const": "inference"},
            "coordinates": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["purpose", "replicate_index"],
                  "properties": {
                    "purpose": {"const": "algorithm_replicate"},
                    "replicate_index": {"type": "integer", "minimum": 1}
                  }
                },
                {"const": {"purpose": "common_algorithm_seed"}}
              ]
            }
          }
        },
        "reference": {"$ref": "#/$defs/inference_artifact"},
        "execution_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    }
  }
}

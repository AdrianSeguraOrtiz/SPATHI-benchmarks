{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/catalog-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "andrea_commit", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "andrea_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "disposition", "tf_list_handling", "routes", "reason"],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "disposition": {"enum": ["candidate", "blocked", "assisted_only"]},
        "tf_list_handling": {
          "enum": ["candidate_restriction", "prior_information", "not_supported"]
        },
        "routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route"}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime", "execution_mode", "variant", "role", "status"],
      "properties": {
        "regime": {
          "enum": ["group_only", "order_aware", "pseudotime_aware", "prior_assisted"]
        },
        "execution_mode": {
          "enum": ["group_native", "group_emulated", "group_aggregated"]
        },
        "variant": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary", "secondary", "assisted"]},
        "status": {"enum": ["candidate", "blocked"]}
      }
    }
  }
}

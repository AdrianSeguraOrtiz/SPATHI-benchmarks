{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/efficiency-safety-panel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "selection_validation_manifest_sha256",
    "budget", "dataset_role", "split_id", "condition_scales", "datasets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_efficiency_safety_panel"},
    "selection_validation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "budget": {"const": "full"},
    "dataset_role": {"const": "efficiency_safety"},
    "split_id": {"const": "efficiency_safety_v1"},
    "condition_scales": {
      "type": "object", "additionalProperties": false,
      "required": ["g3000_tf100_c300", "g3000_tf1500_c300", "g15000_tf100_c300", "g100_tf10_c500_single_group", "g100_tf10_c300_groups_10_40_250", "g100_tf10_c10000"],
      "properties": {
        "g3000_tf100_c300": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 3000}, "transcription_factors": {"const": 100}, "cells": {"const": 300}, "group_sizes": {"const": [100, 100, 100]}}}]},
        "g3000_tf1500_c300": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 3000}, "transcription_factors": {"const": 1500}, "cells": {"const": 300}, "group_sizes": {"const": [100, 100, 100]}}}]},
        "g15000_tf100_c300": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 15000}, "transcription_factors": {"const": 100}, "cells": {"const": 300}, "group_sizes": {"const": [100, 100, 100]}}}]},
        "g100_tf10_c500_single_group": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 100}, "transcription_factors": {"const": 10}, "cells": {"const": 500}, "group_sizes": {"const": [500]}}}]},
        "g100_tf10_c300_groups_10_40_250": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 100}, "transcription_factors": {"const": 10}, "cells": {"const": 300}, "group_sizes": {"const": [10, 40, 250]}}}]},
        "g100_tf10_c10000": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"genes": {"const": 100}, "transcription_factors": {"const": 10}, "cells": {"const": 10000}, "group_sizes": {"const": [3333, 3333, 3334]}}}]}
      }
    },
    "datasets": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/dataset"}}
  },
  "allOf": [
    {"properties": {"datasets": {"contains": {"properties": {"condition_id": {"const": "g3000_tf100_c300"}}, "required": ["condition_id"]}, "minContains": 3, "maxContains": 3}}},
    {"properties": {"datasets": {"contains": {"properties": {"condition_id": {"const": "g3000_tf1500_c300"}}, "required": ["condition_id"]}, "minContains": 3, "maxContains": 3}}},
    {"properties": {"datasets": {"contains": {"properties": {"condition_id": {"const": "g15000_tf100_c300"}}, "required": ["condition_id"]}, "minContains": 3, "maxContains": 3}}},
    {"properties": {"datasets": {"contains": {"properties": {"condition_id": {"const": "g100_tf10_c500_single_group"}}, "required": ["condition_id"]}, "minContains": 3, "maxContains": 3}}},
    {"properties": {"datasets": {"contains": {"properties": {"condition_id": {"const": "g100_tf10_c300_groups_10_40_250"}}, "required": ["condition_id"]}, "minContains": 3, "maxContains": 3}}},
    {"properties": {"datasets": {"contains": {"properties": {"condition_id": {"const": "g100_tf10_c10000"}}, "required": ["condition_id"]}, "minContains": 3, "maxContains": 3}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "file_reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "scale": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_job", "simulator", "genes", "transcription_factors", "cells", "group_sizes", "target_list", "scenario", "simulator_runs", "scenario_inputs"],
      "properties": {
        "generation_job": {"$ref": "#/$defs/id"}, "simulator": {"const": "scmultisim"},
        "genes": {"type": "integer", "minimum": 2}, "transcription_factors": {"type": "integer", "minimum": 1},
        "cells": {"type": "integer", "minimum": 1},
        "group_sizes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "target_list": {"const": null}, "scenario": {"$ref": "#/$defs/file_reference"}, "simulator_runs": {"$ref": "#/$defs/file_reference"},
        "scenario_inputs": {"$ref": "#/$defs/scenario_inputs"}
      }
    },
    "scenario_input": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_path", "kind", "files"],
      "properties": {
        "declared_path": {"$ref": "#/$defs/relative_path"},
        "kind": {"const": "file"},
        "files": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/file_reference"}}
      }
    },
    "scenario_inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["regulatory_network", "tree_newick"],
      "properties": {
        "regulatory_network": {"$ref": "#/$defs/scenario_input"},
        "tree_newick": {"$ref": "#/$defs/scenario_input"}
      }
    },
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "digest"], "properties": {"kind": {"const": "dataset"}, "digest": {"$ref": "#/$defs/sha256"}}},
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "simulator_id", "condition_id", "generation_seed", "contexts", "dataset_artifact"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"}, "simulator_id": {"const": "scmultisim"},
        "condition_id": {"enum": ["g3000_tf100_c300", "g3000_tf1500_c300", "g15000_tf100_c300", "g100_tf10_c500_single_group", "g100_tf10_c300_groups_10_40_250", "g100_tf10_c10000"]},
        "generation_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "contexts": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^group:[^\\s]+$"}},
        "dataset_artifact": {"$ref": "#/$defs/artifact"}
      },
      "allOf": [{"if": {"properties": {"condition_id": {"const": "g100_tf10_c500_single_group"}}, "required": ["condition_id"]}, "then": {"properties": {"contexts": {"minItems": 1, "maxItems": 1}}}, "else": {"properties": {"contexts": {"minItems": 3, "maxItems": 3}}}}]
    }
  }
}

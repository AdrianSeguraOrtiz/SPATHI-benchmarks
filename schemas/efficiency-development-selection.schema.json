{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/efficiency-development-selection.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract", "budget", "analysis_role", "selected_config", "metrics", "execution_state", "selection_rule", "candidate_results", "selected_candidates", "retained_reference_components", "selection_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_efficiency_development_selection"},
    "contract": {"$ref": "#/$defs/reference"},
    "budget": {"enum": ["reduced", "full"]},
    "analysis_role": {"enum": ["descriptive", "selection"]},
    "selected_config": {"$ref": "#/$defs/reference"},
    "metrics": {"$ref": "#/$defs/reference"},
    "execution_state": {"$ref": "#/$defs/reference"},
    "selection_rule": {"type": "object"},
    "candidate_results": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/result"}},
    "selected_candidates": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/selected"}},
    "retained_reference_components": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["target_eligibility", "adaptive_trees", "combined"]}},
    "selection_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "component", "mean_aupr_loss", "wall_time_ratio", "complete", "accuracy_eligible", "dataset_count", "algorithm_seed_count"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"}, "component": {"enum": ["target_eligibility", "adaptive_trees", "combined"]},
        "mean_aupr_loss": {"type": "number"}, "wall_time_ratio": {"type": "number", "exclusiveMinimum": 0}, "complete": {"type": "boolean"}, "accuracy_eligible": {"type": "boolean"},
        "dataset_count": {"type": "integer", "minimum": 1}, "algorithm_seed_count": {"type": "integer", "minimum": 1}
      }
    },
    "selected": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "component", "execution_overrides", "development_result", "candidate_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "component": {"enum": ["target_eligibility", "adaptive_trees", "combined"]}, "execution_overrides": {"type": "object", "minProperties": 1}, "development_result": {"$ref": "#/$defs/result"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/spathi-search-space.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "smoke_contract",
    "dataset_partition",
    "objective",
    "base_configuration",
    "calibration_constraints",
    "conditional_group_policy",
    "calibration_budgets",
    "stages",
    "selection_protocol"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"const": "spathi_calibration_v1"},
    "status": {"const": "planned"},
    "smoke_contract": {"$ref": "#/$defs/smoke_contract"},
    "dataset_partition": {"$ref": "#/$defs/dataset_partition"},
    "objective": {"$ref": "#/$defs/objective"},
    "base_configuration": {"$ref": "#/$defs/complete_parameters"},
    "calibration_constraints": {"$ref": "#/$defs/calibration_constraints"},
    "conditional_group_policy": {"$ref": "#/$defs/policy_template"},
    "calibration_budgets": {"$ref": "#/$defs/calibration_budgets"},
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/geometry_stage"},
        {"$ref": "#/$defs/estimator_stage"},
        {"$ref": "#/$defs/interaction_stage"},
        {"$ref": "#/$defs/estimator_scale_transfer_stage"},
        {"$ref": "#/$defs/convergence_stage"}
      ],
      "items": false
    },
    "selection_protocol": {"$ref": "#/$defs/selection_protocol"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "nonempty_string": {"type": "string", "minLength": 1},
    "smoke_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "current_orchestration_run_id", "role", "eligible_for_scientific_selection", "reason"],
      "properties": {
        "configuration_id": {"const": "spathi_smoke"},
        "current_orchestration_run_id": {"const": "spathi_smoke"},
        "role": {"const": "contract_only"},
        "eligible_for_scientific_selection": {"const": false},
        "reason": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "dataset_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_unit", "stratify_by", "roles", "constraints"],
      "properties": {
        "assignment_unit": {"const": "dataset_instance"},
        "stratify_by": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "contains": {"const": "group_class"},
          "items": {"enum": ["simulator", "topology_id", "generation_seed", "condition_id", "group_class"]}
        },
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"$ref": "#/$defs/development_role"},
            {"$ref": "#/$defs/validation_role"},
            {"$ref": "#/$defs/test_role"}
          ],
          "items": false
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutually_exclusive", "assign_before_inference", "keep_related_datasets_together", "test_access"],
          "properties": {
            "mutually_exclusive": {"const": true},
            "assign_before_inference": {"const": true},
            "keep_related_datasets_together": {"const": true},
            "test_access": {"const": "only_after_policy_freeze"}
          }
        }
      }
    },
    "development_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "permitted_uses"],
      "properties": {
        "id": {"const": "development"},
        "purpose": {"$ref": "#/$defs/nonempty_string"},
        "permitted_uses": {"const": ["geometry_search", "estimator_search", "interaction_search", "estimator_scale_transfer", "fixed_ceiling_convergence"]}
      }
    },
    "validation_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "permitted_uses"],
      "properties": {
        "id": {"const": "validation"},
        "purpose": {"$ref": "#/$defs/nonempty_string"},
        "permitted_uses": {"const": ["finalist_selection"]}
      }
    },
    "test_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "permitted_uses"],
      "properties": {
        "id": {"const": "test"},
        "purpose": {"$ref": "#/$defs/nonempty_string"},
        "permitted_uses": {"const": ["frozen_benchmark_only"]}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "edge_semantics", "direction", "aggregation", "tie_breakers", "forbidden_shortcuts"],
      "properties": {
        "primary_metric": {"const": "aupr_directed"},
        "edge_semantics": {"const": "directed_unsigned"},
        "direction": {"const": "maximize"},
        "aggregation": {
          "const": [
            {"level": "group", "operation": "equal_weight_mean", "scope": "within_dataset"},
            {"level": "algorithm_seed", "operation": "equal_weight_mean", "scope": "within_dataset_and_configuration"},
            {"level": "dataset", "operation": "equal_weight_mean", "scope": "within_dataset_role"}
          ]
        },
        "tie_breakers": {
          "const": [
            {"priority": 1, "id": "stability", "direction": "minimize", "measure": "aupr_dispersion_across_algorithmic_seeds"},
            {"priority": 2, "id": "simplicity", "direction": "minimize", "measure": "parameter_changes_from_base_configuration"},
            {"priority": 3, "id": "canonical_configuration_id", "direction": "ascending", "measure": "lexicographic_configuration_id"}
          ]
        },
        "forbidden_shortcuts": {"const": ["pool_edges_across_groups", "split_cells_from_one_dataset_across_roles", "select_a_different_policy_per_dataset", "use_test_results_for_selection"]}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight_mode": {"enum": ["cell-distance", "cell-distance-group-anchored", "group-distance"]},
        "distance_space": {"enum": ["pca", "expression"]},
        "n_components": {"type": "integer", "minimum": 1},
        "distance_standardization": {"enum": ["none", "standard"]},
        "pca_svd_solver": {"enum": ["auto", "randomized", "full"]},
        "distance_metric": {"enum": ["euclidean", "cosine"]},
        "kernel": {"enum": ["gaussian", "exponential"]},
        "bandwidth": {"const": "auto"},
        "bandwidth_scale": {"type": "number", "exclusiveMinimum": 0},
        "group_size_correction": {"enum": ["none", "cap-to-target"]},
        "tree_method": {"enum": ["extra-trees", "random-forest"]},
        "n_estimators": {"type": "integer", "minimum": 1},
        "max_features": {
          "anyOf": [
            {"enum": ["sqrt", "log2"]},
            {"type": "integer", "minimum": 1},
            {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          ]
        },
        "min_samples_leaf": {"type": "integer", "minimum": 1},
        "max_depth": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "bootstrap": {"type": "boolean"},
        "target_eligibility": {"const": "all"},
        "min_target_detected_cells": {"type": "integer", "minimum": 1},
        "min_target_detected_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_target_weighted_detected_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_target_weighted_detected_ess": {"type": "number", "exclusiveMinimum": 0},
        "adaptive_trees": {"const": false},
        "adaptive_min_estimators": {"type": "integer", "minimum": 1},
        "adaptive_tree_step": {"type": "integer", "minimum": 1},
        "adaptive_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "adaptive_patience": {"type": "integer", "minimum": 1}
      }
    },
    "complete_parameters": {
      "allOf": [
        {"$ref": "#/$defs/parameters"},
        {"required": ["weight_mode", "distance_space", "n_components", "distance_standardization", "pca_svd_solver", "distance_metric", "kernel", "bandwidth", "bandwidth_scale", "group_size_correction", "tree_method", "n_estimators", "max_features", "min_samples_leaf", "max_depth", "bootstrap", "target_eligibility", "min_target_detected_cells", "min_target_detected_fraction", "min_target_weighted_detected_fraction", "min_target_weighted_detected_ess", "adaptive_trees", "adaptive_min_estimators", "adaptive_tree_step", "adaptive_tolerance", "adaptive_patience"]}
      ]
    },
    "calibration_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_parameters", "fixed_parameter_rationales", "excluded_inputs", "purpose"],
      "properties": {
        "fixed_parameters": {
          "const": {"bandwidth": "auto", "target_eligibility": "all", "adaptive_trees": false}
        },
        "fixed_parameter_rationales": {
          "const": {
            "bandwidth": "The automatic bandwidth adapts to each dataset's distance units. The transferable bandwidth_scale parameter varies smoothing intensity without fitting a non-portable absolute width.",
            "target_eligibility": "All requested targets define the exact scientific reference. Automatic target eligibility is developed and independently validated only as an efficiency policy.",
            "adaptive_trees": "Fixed forests define the exact scientific reference. Adaptive stopping is developed and independently validated only as an efficiency policy."
          }
        },
        "excluded_inputs": {"const": ["target_list", "centroid_weights"]},
        "purpose": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_group_count"],
      "properties": {
        "minimum_group_count": {"type": "integer", "minimum": 1},
        "maximum_group_count": {"type": "integer", "minimum": 1}
      }
    },
    "policy_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_parameter", "shared_parameters", "branches"],
      "properties": {
        "routing_parameter": {"const": "group_count"},
        "shared_parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["single_group", "multi_group"],
          "properties": {
            "single_group": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "parameter_overrides"],
              "properties": {
                "condition": {"const": {"minimum_group_count": 1, "maximum_group_count": 1}},
                "parameter_overrides": {"const": {"weight_mode": "cell-distance", "distance_metric": "euclidean", "group_size_correction": "none"}}
              }
            },
            "multi_group": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "parameter_overrides"],
              "properties": {
                "condition": {"const": {"minimum_group_count": 2}},
                "parameter_overrides": {"const": {}}
              }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_overrides", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "parameter_overrides": {"allOf": [{"$ref": "#/$defs/parameters"}, {"minProperties": 1}]},
        "rationale": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "algorithmic_seeds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "target_scope": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["method"], "properties": {"method": {"const": "all"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "size", "salt"],
          "properties": {
            "method": {"const": "sha256_gene_id"},
            "size": {"const": 256},
            "salt": {"const": "spathi-calibration-high-tf-v1"}
          }
        }
      ]
    },
    "fidelity_dataset_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_ids", "replicate_indices"],
      "properties": {
        "condition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "replicate_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 3}}
      }
    },
    "fidelity_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_source", "advance_limit", "dataset_selector", "algorithm_seed_indices", "target_scope", "expected_physical_fits"],
      "properties": {
        "candidate_source": {"enum": ["all_expanded", "scout_shortlist"]},
        "advance_limit": {"type": "integer", "minimum": 1, "maximum": 9},
        "dataset_selector": {"$ref": "#/$defs/fidelity_dataset_selector"},
        "algorithm_seed_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 5}},
        "target_scope": {"$ref": "#/$defs/target_scope"},
        "expected_physical_fits": {"type": "integer", "minimum": 1}
      }
    },
    "multifidelity_search_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scout", "confirmation"],
      "properties": {
        "scout": {"$ref": "#/$defs/fidelity_tier"},
        "confirmation": {"$ref": "#/$defs/fidelity_tier"}
      }
    },
    "multifidelity_final_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_source", "advance_limit", "algorithm_seed_indices", "target_scope", "expected_physical_fits"],
      "properties": {
        "candidate_source": {"enum": ["confirmation_shortlist", "convergence_shortlist"]},
        "advance_limit": {"type": "integer", "minimum": 1, "maximum": 2},
        "dataset_selector": {"$ref": "#/$defs/fidelity_dataset_selector"},
        "expected_dataset_count": {"type": "integer", "minimum": 1},
        "algorithm_seed_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 5}},
        "target_scope": {"$ref": "#/$defs/target_scope"},
        "execution_primitive": {"const": "largest_forest_with_declared_prefixes"},
        "logical_results_per_fit": {"const": 4},
        "expected_logical_results": {"type": "integer", "minimum": 1},
        "expected_physical_fits": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {"required": ["dataset_selector", "execution_primitive", "logical_results_per_fit", "expected_logical_results"], "not": {"required": ["expected_dataset_count"]}},
        {"required": ["expected_dataset_count"], "not": {"anyOf": [{"required": ["dataset_selector"]}, {"required": ["execution_primitive"]}]}}
      ]
    },
    "multifidelity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_profile", "may_consume_other_profile_outcomes", "ranking_rule", "panel_assignment", "forbidden_scout_inputs", "stages"],
      "properties": {
        "independent_profile": {"const": true},
        "may_consume_other_profile_outcomes": {"const": false},
        "ranking_rule": {"const": "primary_metric_then_frozen_tie_breakers"},
        "panel_assignment": {"const": "predeclared_before_outcomes"},
        "forbidden_scout_inputs": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["ground_truth_for_target_selection", "expression_values_for_target_selection", "test_outcomes", "reduced_outcomes", "full_outcomes"]}},
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence", "validation"],
          "properties": {
            "geometry": {"$ref": "#/$defs/multifidelity_search_stage"},
            "estimator": {"$ref": "#/$defs/multifidelity_search_stage"},
            "interaction": {"$ref": "#/$defs/multifidelity_search_stage"},
            "estimator_scale_transfer": {"$ref": "#/$defs/multifidelity_search_stage"},
            "convergence": {"$ref": "#/$defs/multifidelity_final_stage"},
            "validation": {"$ref": "#/$defs/multifidelity_final_stage"}
          }
        }
      }
    },
    "budget_seed_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence", "validation"],
      "properties": {
        "geometry": {"$ref": "#/$defs/algorithmic_seeds"},
        "estimator": {"$ref": "#/$defs/algorithmic_seeds"},
        "interaction": {"$ref": "#/$defs/algorithmic_seeds"},
        "estimator_scale_transfer": {"$ref": "#/$defs/algorithmic_seeds"},
        "convergence": {"$ref": "#/$defs/algorithmic_seeds"},
        "validation": {"$ref": "#/$defs/algorithmic_seeds"}
      }
    },
    "calibration_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "reduced"],
      "properties": {
        "full": {"type": "object", "additionalProperties": false, "required": ["algorithmic_seeds", "expected_physical_fits", "expected_logical_results", "multifidelity"], "properties": {"algorithmic_seeds": {"$ref": "#/$defs/budget_seed_map"}, "expected_physical_fits": {"const": 1762}, "expected_logical_results": {"const": 2482}, "multifidelity": {"$ref": "#/$defs/multifidelity_contract"}}},
        "reduced": {"type": "object", "additionalProperties": false, "required": ["algorithmic_seeds", "expected_physical_fits", "expected_logical_results", "multifidelity"], "properties": {"algorithmic_seeds": {"$ref": "#/$defs/budget_seed_map"}, "expected_physical_fits": {"const": 431}, "expected_logical_results": {"const": 527}, "multifidelity": {"$ref": "#/$defs/multifidelity_contract"}}}
      }
    },
    "stage_common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "dataset_role", "purpose", "inherits_from", "strategy", "dataset_selector", "include_inherited_configuration", "maximum_parent_configurations", "candidate_budget_per_parent", "candidates", "advance_limit"],
      "properties": {
        "id": {"enum": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence"]},
        "order": {"type": "integer", "minimum": 1, "maximum": 5},
        "dataset_role": {"const": "development"},
        "purpose": {"$ref": "#/$defs/nonempty_string"},
        "inherits_from": {"enum": ["base_configuration", "shortlist:geometry", "shortlist:estimator", "shortlist:estimator_scale_transfer", "shortlist:interaction"]},
        "strategy": {"enum": ["bounded_constrained_design", "bounded_crossed_shortlist", "crossed_high_tf_feature_transfer", "bounded_interaction_design", "fixed_ceiling_sweep"]},
        "dataset_selector": {"$ref": "#/$defs/dataset_selector"},
        "include_inherited_configuration": {"type": "boolean"},
        "maximum_parent_configurations": {"type": "integer", "minimum": 1, "maximum": 3},
        "candidate_budget_per_parent": {"type": "integer", "minimum": 1, "maximum": 16},
        "parent_expansion_identity": {"$ref": "#/$defs/parent_expansion_identity"},
        "selection_rule": {"$ref": "#/$defs/convergence_selection_rule"},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 15, "items": {"$ref": "#/$defs/candidate"}},
        "advance_limit": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "parent_expansion_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_parameters", "required_distinct_parents"],
      "properties": {
        "excluded_parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_distinct_parents": {"type": "integer", "minimum": 2, "maximum": 3}
      }
    },
    "dataset_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_id", "condition_ids"],
      "properties": {
        "split_id": {"$ref": "#/$defs/id"},
        "condition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "geometry_stage": {
      "allOf": [{"$ref": "#/$defs/stage_common"}, {"properties": {"id": {"const": "geometry"}, "order": {"const": 1}, "inherits_from": {"const": "base_configuration"}, "strategy": {"const": "bounded_constrained_design"}, "maximum_parent_configurations": {"const": 1}, "candidates": {"minItems": 1}, "advance_limit": {"const": 3}}}]
    },
    "estimator_stage": {
      "allOf": [{"$ref": "#/$defs/stage_common"}, {"properties": {"id": {"const": "estimator"}, "order": {"const": 2}, "inherits_from": {"const": "shortlist:geometry"}, "strategy": {"const": "bounded_crossed_shortlist"}, "maximum_parent_configurations": {"const": 3}, "candidates": {"minItems": 1}, "advance_limit": {"const": 3}}}]
    },
    "estimator_scale_transfer_stage": {
      "allOf": [{"$ref": "#/$defs/stage_common"}, {"required": ["parent_expansion_identity"], "properties": {"id": {"const": "estimator_scale_transfer"}, "order": {"const": 4}, "inherits_from": {"const": "shortlist:interaction"}, "strategy": {"const": "crossed_high_tf_feature_transfer"}, "include_inherited_configuration": {"const": false}, "maximum_parent_configurations": {"const": 3}, "candidate_budget_per_parent": {"const": 6}, "parent_expansion_identity": {"const": {"excluded_parameters": ["max_features"], "required_distinct_parents": 3}}, "candidates": {"minItems": 6, "maxItems": 6}, "advance_limit": {"const": 2}}}]
    },
    "interaction_stage": {
      "allOf": [{"$ref": "#/$defs/stage_common"}, {"required": ["parent_expansion_identity"], "properties": {"id": {"const": "interaction"}, "order": {"const": 3}, "inherits_from": {"const": "shortlist:estimator"}, "strategy": {"const": "bounded_interaction_design"}, "include_inherited_configuration": {"const": false}, "maximum_parent_configurations": {"const": 3}, "candidate_budget_per_parent": {"const": 6}, "parent_expansion_identity": {"const": {"excluded_parameters": ["tree_method", "max_features", "min_samples_leaf", "max_depth", "bootstrap"], "required_distinct_parents": 3}}, "candidates": {"minItems": 6, "maxItems": 6}, "advance_limit": {"const": 3}}}]
    },
    "convergence_stage": {
      "allOf": [{"$ref": "#/$defs/stage_common"}, {"required": ["selection_rule"], "properties": {"id": {"const": "convergence"}, "order": {"const": 5}, "inherits_from": {"const": "shortlist:estimator_scale_transfer"}, "strategy": {"const": "fixed_ceiling_sweep"}, "maximum_parent_configurations": {"const": 2}, "candidates": {"minItems": 1}, "advance_limit": {"const": 2}}}]
    },
    "convergence_selection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reference", "absolute_aupr_margin", "maximum_stability_increase"],
      "properties": {
        "method": {"const": "smallest_noninferior_stable_per_parent"},
        "reference": {"const": "largest_n_estimators_within_parent"},
        "absolute_aupr_margin": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_stability_increase": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "selection_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development_role", "validation_role", "test_role", "maximum_validation_finalists", "freeze_before_test", "selection_unit", "test_results_can_change_selection"],
      "properties": {
        "development_role": {"const": "search_and_shortlist"},
        "validation_role": {"const": "select_one_conditional_policy"},
        "test_role": {"const": "compare_frozen_policy"},
        "maximum_validation_finalists": {"const": 2},
        "freeze_before_test": {"const": true},
        "selection_unit": {"const": "conditional_group_policy"},
        "test_results_can_change_selection": {"const": false}
      }
    }
  }
}

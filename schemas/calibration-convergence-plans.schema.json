{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi-benchmarks.local/schemas/calibration-convergence-plans.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "physical_plans_per_dataset", "logical_results_per_dataset", "plans"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_calibration_convergence_plans"},
    "physical_plans_per_dataset": {"type": "integer", "minimum": 1},
    "logical_results_per_dataset": {"type": "integer", "minimum": 4},
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/plan"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "physical_run_id", "parent_configuration_id", "algorithm_seed", "model", "logical_prefixes"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "physical_run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "parent_configuration_id": {"type": "string", "minLength": 1},
        "algorithm_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "model": {"type": "object", "minProperties": 2},
        "logical_prefixes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/prefix250"},
            {"$ref": "#/$defs/prefix500"},
            {"$ref": "#/$defs/prefix750"},
            {"$ref": "#/$defs/prefix1000"}
          ],
          "items": false
        }
      }
    },
    "prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "configuration_id", "configuration_sha256", "n_estimators"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "configuration_id": {"type": "string", "minLength": 1},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "n_estimators": {"type": "integer", "minimum": 1}
      }
    },
    "prefix250": {"allOf": [{"$ref": "#/$defs/prefix"}, {"properties": {"n_estimators": {"const": 250}}}]},
    "prefix500": {"allOf": [{"$ref": "#/$defs/prefix"}, {"properties": {"n_estimators": {"const": 500}}}]},
    "prefix750": {"allOf": [{"$ref": "#/$defs/prefix"}, {"properties": {"n_estimators": {"const": 750}}}]},
    "prefix1000": {"allOf": [{"$ref": "#/$defs/prefix"}, {"properties": {"n_estimators": {"const": 1000}}}]}
  }
}

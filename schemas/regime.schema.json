{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/regime.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "primary",
    "available_information",
    "excluded_information",
    "planned_variants",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"enum": ["group_only", "order_aware", "prior_assisted"]},
    "primary": {"type": "boolean"},
    "available_information": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "excluded_information": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "planned_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "execution_mode",
          "variant",
          "role",
          "status",
          "tf_list_handling"
        ],
        "properties": {
          "tool_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "execution_mode": {
            "enum": ["group_native", "group_emulated", "group_aggregated"]
          },
          "variant": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary", "secondary", "implementation_sensitivity", "assisted"]},
          "status": {"enum": ["candidate", "blocked"]},
          "tf_list_handling": {
            "enum": ["candidate_restriction", "prior_information", "not_supported"]
          }
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

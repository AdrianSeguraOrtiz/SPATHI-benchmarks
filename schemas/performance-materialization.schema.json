{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/performance-materialization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "budget",
    "design",
    "template_profile",
    "selected_config",
    "runtime_plan",
    "execution",
    "datasets",
    "scientific_requests",
    "tasks",
    "schedule_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_performance_materialization"},
    "budget": {"enum": ["reduced", "full"]},
    "design": {"$ref": "#/$defs/reference"},
    "template_profile": {"$ref": "#/$defs/reference"},
    "selected_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "policy_id", "policy_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "policy_id": {"$ref": "#/$defs/id"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint", "execution_class", "request", "detected", "capacity"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "execution_class": {"const": "performance_full"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_cores", "max_ram_gb", "reserve_cores", "reserve_ram_gb"],
          "properties": {
            "max_cores": {"type": ["integer", "null"], "minimum": 1},
            "max_ram_gb": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "reserve_cores": {"type": "integer", "minimum": 0},
            "reserve_ram_gb": {"type": "number", "minimum": 0}
          }
        },
        "detected": {"type": "object", "minProperties": 1},
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_threads", "memory_bytes"],
          "properties": {
            "cpu_threads": {"type": "integer", "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1073741824}
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_profile",
        "inference_cache",
        "concurrency",
        "order_algorithm",
        "order_salt",
        "max_ram_gb",
        "planner",
        "planner_time_limit_seconds",
        "timeout_seconds"
      ],
      "properties": {
        "output_profile": {"const": "full"},
        "inference_cache": {"const": "disabled"},
        "concurrency": {"const": "one_logical_execution_at_a_time"},
        "order_algorithm": {"const": "sha256_rank_rotate_reverse_v1"},
        "order_salt": {"const": "spathi-performance-counterbalance-v1"},
        "max_ram_gb": {"type": "number", "minimum": 1},
        "planner": {"enum": ["auto", "cp_sat", "heuristic"]},
        "planner_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["generation_job_id", "replicate_index", "size_class"],
        "properties": {
          "generation_job_id": {"$ref": "#/$defs/id"},
          "replicate_index": {"type": "integer", "minimum": 1},
          "size_class": {"enum": ["small", "medium"]}
        }
      }
    },
    "scientific_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "configuration_id",
          "tool_id",
          "origin",
          "algorithm_seed",
          "request",
          "custom_tool"
        ],
        "properties": {
          "configuration_id": {"$ref": "#/$defs/id"},
          "tool_id": {"$ref": "#/$defs/id"},
          "origin": {"enum": ["catalog", "spathi_selected_policy"]},
          "algorithm_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
          "request": {"type": "object"},
          "custom_tool": {"type": ["object", "null"]}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "schedule_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "sequence_index",
        "phase",
        "generation_job_id",
        "replicate_index",
        "size_class",
        "configuration_id",
        "tool_id",
        "origin",
        "threads",
        "ram_gb",
        "cpuset_cpus",
        "system_repetition"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "sequence_index": {"type": "integer", "minimum": 1},
        "phase": {"enum": ["warmup", "measurement"]},
        "generation_job_id": {"$ref": "#/$defs/id"},
        "replicate_index": {"type": "integer", "minimum": 1},
        "size_class": {"enum": ["small", "medium"]},
        "configuration_id": {"$ref": "#/$defs/id"},
        "tool_id": {"$ref": "#/$defs/id"},
        "origin": {"enum": ["catalog", "spathi_selected_policy"]},
        "threads": {"type": "integer", "minimum": 1},
        "ram_gb": {"type": "number", "exclusiveMinimum": 0},
        "cpuset_cpus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "system_repetition": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/spathi-selected-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "search_space", "calibration_budget", "status", "phase", "selected_policy", "selection_evidence", "test_accessed_before_freeze", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"const": "spathi_selected_v1"},
    "search_space": {"const": "experiments/v1/spathi/search-space.json"},
    "calibration_budget": {"anyOf": [{"type": "null"}, {"enum": ["full", "reduced"]}]},
    "status": {"enum": ["unselected", "selected"]},
    "phase": {"enum": ["planned", "frozen"]},
    "selected_policy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/selected_policy"}]},
    "selection_evidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/selection_evidence"}]},
    "test_accessed_before_freeze": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "unselected"}}, "required": ["status"]},
      "then": {"properties": {"phase": {"const": "planned"}, "calibration_budget": {"type": "null"}, "selected_policy": {"type": "null"}, "selection_evidence": {"type": "null"}, "test_accessed_before_freeze": {"const": false}}}
    },
    {
      "if": {"properties": {"status": {"const": "selected"}}, "required": ["status"]},
      "then": {"properties": {"phase": {"const": "frozen"}, "calibration_budget": {"enum": ["full", "reduced"]}, "selected_policy": {"$ref": "#/$defs/selected_policy"}, "selection_evidence": {"$ref": "#/$defs/selection_evidence"}, "test_accessed_before_freeze": {"const": false}}}
    },
    {
      "if": {"properties": {"calibration_budget": {"const": "full"}}, "required": ["calibration_budget"]},
      "then": {"properties": {"selection_evidence": {"type": "object", "properties": {"calibration_budget": {"const": "full"}}}}}
    },
    {
      "if": {"properties": {"calibration_budget": {"const": "reduced"}}, "required": ["calibration_budget"]},
      "then": {"properties": {"selection_evidence": {"type": "object", "properties": {"calibration_budget": {"const": "reduced"}}}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight_mode", "distance_space", "n_components", "distance_standardization", "pca_svd_solver", "distance_metric", "kernel", "bandwidth", "bandwidth_scale", "group_size_correction", "tree_method", "n_estimators", "max_features", "min_samples_leaf", "max_depth", "bootstrap"],
      "properties": {
        "weight_mode": {"enum": ["cell-distance", "cell-distance-group-anchored", "group-distance"]},
        "distance_space": {"enum": ["pca", "expression"]},
        "n_components": {"type": "integer", "minimum": 1},
        "distance_standardization": {"enum": ["none", "standard"]},
        "pca_svd_solver": {"enum": ["auto", "randomized", "full"]},
        "distance_metric": {"enum": ["euclidean", "cosine"]},
        "kernel": {"enum": ["gaussian", "exponential"]},
        "bandwidth": {"const": "auto"},
        "bandwidth_scale": {"type": "number", "exclusiveMinimum": 0},
        "group_size_correction": {"enum": ["none", "cap-to-target"]},
        "tree_method": {"enum": ["extra-trees", "random-forest"]},
        "n_estimators": {"type": "integer", "minimum": 1},
        "max_features": {"anyOf": [{"enum": ["sqrt", "log2"]}, {"type": "integer", "minimum": 1}, {"type": "number", "exclusiveMinimum": 0, "maximum": 1}]},
        "min_samples_leaf": {"type": "integer", "minimum": 1},
        "max_depth": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "bootstrap": {"type": "boolean"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_group_count"],
      "properties": {"minimum_group_count": {"type": "integer", "minimum": 1}, "maximum_group_count": {"type": "integer", "minimum": 1}}
    },
    "group_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_parameter", "shared_parameters", "branches"],
      "properties": {
        "routing_parameter": {"const": "group_count"},
        "shared_parameters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["single_group", "multi_group"],
          "properties": {
            "single_group": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "parameters"],
              "properties": {
                "condition": {"const": {"minimum_group_count": 1, "maximum_group_count": 1}},
                "parameters": {"allOf": [{"$ref": "#/$defs/parameters"}, {"properties": {"weight_mode": {"const": "cell-distance"}, "distance_metric": {"const": "euclidean"}, "group_size_correction": {"const": "none"}}}]}
              }
            },
            "multi_group": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "parameters"],
              "properties": {"condition": {"const": {"minimum_group_count": 2}}, "parameters": {"$ref": "#/$defs/parameters"}}
            }
          }
        }
      }
    },
    "selected_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "source_candidate_id", "spathi_commit", "source_configuration_sha256", "policy_sha256", "group_policy"],
      "properties": {
        "policy_id": {"const": "spathi_conditional_v1"},
        "source_candidate_id": {"$ref": "#/$defs/id"},
        "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "group_policy": {"$ref": "#/$defs/group_policy"}
      }
    },
    "selection_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_ranking", "calibration_budget", "validation_ranking_sha256", "search_space_sha256", "validation_manifest_sha256", "benchmark_summary_sha256", "spathi_build_fingerprint", "spathi_image_id", "primary_metric", "hierarchical_score", "winner_candidate_id", "winner_configuration_sha256", "winner_policy_sha256", "tie_breakers_applied", "frozen_at"],
      "properties": {
        "calibration_budget": {"enum": ["full", "reduced"]},
        "validation_ranking": {"$ref": "#/$defs/relative_path"},
        "validation_ranking_sha256": {"$ref": "#/$defs/sha256"},
        "search_space_sha256": {"$ref": "#/$defs/sha256"},
        "validation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_summary_sha256": {"$ref": "#/$defs/sha256"},
        "spathi_build_fingerprint": {"$ref": "#/$defs/sha256"},
        "spathi_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "primary_metric": {"const": "aupr_directed"},
        "hierarchical_score": {"type": "number", "minimum": 0, "maximum": 1},
        "winner_candidate_id": {"$ref": "#/$defs/id"},
        "winner_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "winner_policy_sha256": {"$ref": "#/$defs/sha256"},
        "tie_breakers_applied": {"const": ["stability", "simplicity", "canonical_configuration_id"]},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

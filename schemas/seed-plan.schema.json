{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/seed-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "master_seed",
    "derivation",
    "streams",
    "namespaces",
    "allocations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "description": {"type": "string", "minLength": 1},
    "master_seed": {"$ref": "#/$defs/seed"},
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "domain_separator", "encoding", "projection"],
      "properties": {
        "algorithm": {"const": "sha256-domain-separated-uint32-v1"},
        "domain_separator": {"const": "org.spathi.benchmarks.seed-plan.v1"},
        "encoding": {"const": "canonical-json-utf8"},
        "projection": {"const": "first-64-bits-big-endian-mod-2147483646-plus-1"}
      }
    },
    "streams": {
      "const": [
        "generation",
        "augmentation",
        "inference",
        "statistical"
      ]
    },
    "namespaces": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/namespace"}
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/allocation"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "budget", "dataset_role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "budget": {"enum": ["smoke", "reduced", "full"]},
        "dataset_role": {
          "enum": [
            "smoke",
            "development",
            "validation",
            "test",
            "scalability",
            "dimensional_transfer",
            "performance"
          ]
        }
      }
    },
    "coordinate": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "integer"},
        {"type": "boolean"}
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "run_id", "offset", "span"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "run_id": {"$ref": "#/$defs/id"},
        "offset": {"type": "integer", "minimum": 0},
        "span": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "namespace", "stream", "coordinates", "span", "seed"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "namespace": {"$ref": "#/$defs/id"},
        "stream": {
          "enum": [
            "generation",
            "augmentation",
            "inference",
            "statistical"
          ]
        },
        "coordinates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/coordinate"}
        },
        "span": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "seed": {"$ref": "#/$defs/seed"},
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/consumer"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"stream": {"const": "generation"}}, "required": ["stream"]},
          "then": {},
          "else": {"not": {"required": ["consumers"]}}
        }
      ]
    }
  }
}

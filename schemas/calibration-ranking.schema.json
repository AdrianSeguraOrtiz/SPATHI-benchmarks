{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/calibration-ranking.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "profile_id", "calibration_budget", "search_space_id", "search_space_sha256", "stage_id", "dataset_role", "parent_ranking", "calibration_manifest_sha256", "benchmark_summary_sha256", "benchmark_commit", "spathi_commit", "spathi_build_fingerprint", "spathi_image_tag", "spathi_image_ids", "primary_metric", "tie_breakers", "calibration_panel", "calibration_rows", "ranking", "selected_candidates", "winner", "test_data_accessed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_calibration_ranking"},
    "profile_id": {"type": "string", "pattern": "^(?:calibration-(?:full|reduced)-(?:geometry|estimator|estimator_scale_transfer|interaction|convergence)|selection-(?:full|reduced)-validation)$"},
    "calibration_budget": {"enum": ["full", "reduced"]},
    "search_space_id": {"const": "spathi_calibration_v1"},
    "search_space_sha256": {"$ref": "#/$defs/sha256"},
    "stage_id": {"$ref": "#/$defs/stage_id"},
    "dataset_role": {"enum": ["development", "validation"]},
    "parent_ranking": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/parent_ranking"}]},
    "calibration_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_summary_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "spathi_build_fingerprint": {"$ref": "#/$defs/sha256"},
    "spathi_image_tag": {"type": "string", "minLength": 1},
    "spathi_image_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "primary_metric": {"const": "aupr_directed"},
    "tie_breakers": {"const": ["stability", "simplicity", "canonical_configuration_id"]},
    "calibration_panel": {"$ref": "#/$defs/calibration_panel"},
    "calibration_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/calibration_row"}},
    "ranking": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/score"}},
    "selected_candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
    "winner": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/winner"}]},
    "test_data_accessed": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"stage_id": {"const": "geometry"}}}, "then": {"properties": {"profile_id": {"pattern": "^calibration-(?:full|reduced)-geometry$"}, "dataset_role": {"const": "development"}, "parent_ranking": {"type": "null"}, "winner": {"type": "null"}}}},
    {"if": {"properties": {"stage_id": {"const": "estimator"}}}, "then": {"properties": {"profile_id": {"pattern": "^calibration-(?:full|reduced)-estimator$"}, "dataset_role": {"const": "development"}, "parent_ranking": {"allOf": [{"$ref": "#/$defs/parent_ranking"}, {"properties": {"stage_id": {"const": "geometry"}}}]}, "winner": {"type": "null"}}}},
    {"if": {"properties": {"stage_id": {"const": "interaction"}}}, "then": {"properties": {"profile_id": {"pattern": "^calibration-(?:full|reduced)-interaction$"}, "dataset_role": {"const": "development"}, "parent_ranking": {"allOf": [{"$ref": "#/$defs/parent_ranking"}, {"properties": {"stage_id": {"const": "estimator"}}}]}, "winner": {"type": "null"}}}},
    {"if": {"properties": {"stage_id": {"const": "estimator_scale_transfer"}}}, "then": {"properties": {"profile_id": {"pattern": "^calibration-(?:full|reduced)-estimator_scale_transfer$"}, "dataset_role": {"const": "development"}, "parent_ranking": {"allOf": [{"$ref": "#/$defs/parent_ranking"}, {"properties": {"stage_id": {"const": "interaction"}}}]}, "ranking": {"minItems": 1, "maxItems": 18}, "selected_candidates": {"minItems": 1, "maxItems": 2}, "winner": {"type": "null"}}}},
    {"if": {"properties": {"stage_id": {"const": "convergence"}}}, "then": {"properties": {"profile_id": {"pattern": "^calibration-(?:full|reduced)-convergence$"}, "dataset_role": {"const": "development"}, "parent_ranking": {"allOf": [{"$ref": "#/$defs/parent_ranking"}, {"properties": {"stage_id": {"const": "estimator_scale_transfer"}}}]}, "winner": {"type": "null"}}}},
    {"if": {"properties": {"stage_id": {"const": "validation"}}}, "then": {"properties": {"profile_id": {"pattern": "^selection-(?:full|reduced)-validation$"}, "dataset_role": {"const": "validation"}, "parent_ranking": {"allOf": [{"$ref": "#/$defs/parent_ranking"}, {"properties": {"stage_id": {"const": "convergence"}}}]}, "ranking": {"minItems": 2, "maxItems": 3}, "selected_candidates": {"minItems": 1, "maxItems": 1}, "winner": {"$ref": "#/$defs/winner"}}}},
    {"if": {"properties": {"calibration_budget": {"const": "full"}}}, "then": {"properties": {"profile_id": {"pattern": "^(?:calibration-full-|selection-full-)"}, "parent_ranking": {"anyOf": [{"type": "null"}, {"type": "object", "properties": {"calibration_budget": {"const": "full"}}}]}}}},
    {"if": {"properties": {"calibration_budget": {"const": "reduced"}}}, "then": {"properties": {"profile_id": {"pattern": "^(?:calibration-reduced-|selection-reduced-)"}, "parent_ranking": {"anyOf": [{"type": "null"}, {"type": "object", "properties": {"calibration_budget": {"const": "reduced"}}}]}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "search_stage_id": {"enum": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence"]},
    "stage_id": {"enum": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence", "validation"]},
    "parent_ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "stage_id", "calibration_budget"],
      "properties": {"path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "stage_id": {"$ref": "#/$defs/search_stage_id"}, "calibration_budget": {"enum": ["full", "reduced"]}}
    },
    "calibration_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "configuration_sha256", "dataset_role", "dataset_id", "algorithm_seed", "aupr_directed", "wall_time_seconds", "peak_memory_mb", "n_group_contexts", "group_contexts", "spathi_commit", "spathi_build_fingerprint", "spathi_image_id", "run_id", "execution_sha256"],
      "properties": {
        "configuration_id": {"$ref": "#/$defs/id"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_role": {"enum": ["development", "validation"]},
        "dataset_id": {"type": "string", "minLength": 1},
        "algorithm_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "aupr_directed": {"type": "number", "minimum": 0, "maximum": 1},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "peak_memory_mb": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "n_group_contexts": {"type": "integer", "minimum": 1},
        "group_contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^group:.+$"}},
        "spathi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "spathi_build_fingerprint": {"$ref": "#/$defs/sha256"},
        "spathi_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "run_id": {"$ref": "#/$defs/id"},
        "execution_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "calibration_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "dataset_role", "dataset_ids", "run_ids", "n_expected_executions", "handoff_validation_sha256", "datasets"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "dataset_role": {"enum": ["development", "validation"]},
        "dataset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "n_expected_executions": {"type": "integer", "minimum": 1},
        "handoff_validation_sha256": {"$ref": "#/$defs/sha256"},
        "datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/calibration_dataset_contract"}}
      }
    },
    "calibration_dataset_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "expected_group_contexts", "n_group_contexts", "dataset_manifest_sha256", "group_assignments_sha256", "ground_truth_manifest_sha256", "truth_network_sha256"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "expected_group_contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^group:.+$"}},
        "n_group_contexts": {"type": "integer", "minimum": 1},
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "group_assignments_sha256": {"$ref": "#/$defs/sha256"},
        "ground_truth_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "truth_network_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "configuration_sha256", "stage_id", "dataset_role", "parent_configuration_id", "variant_id", "parameters", "base_parameter_changes"],
      "properties": {
        "configuration_id": {"$ref": "#/$defs/id"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "stage_id": {"$ref": "#/$defs/search_stage_id"},
        "dataset_role": {"const": "development"},
        "parent_configuration_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "variant_id": {"$ref": "#/$defs/id"},
        "parameters": {"type": "object", "minProperties": 1},
        "base_parameter_changes": {"type": "integer", "minimum": 0}
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "hierarchical_aupr", "stability", "median_wall_time_seconds", "median_peak_memory_mb", "simplicity", "dataset_count", "algorithm_seed_count"],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "hierarchical_aupr": {"type": "number", "minimum": 0, "maximum": 1},
        "stability": {"type": "number", "minimum": 0},
        "median_wall_time_seconds": {"type": "number", "minimum": 0},
        "median_peak_memory_mb": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "simplicity": {"type": "integer", "minimum": 0},
        "dataset_count": {"type": "integer", "minimum": 1},
        "algorithm_seed_count": {"type": "integer", "minimum": 2}
      }
    },
    "winner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "configuration_sha256", "hierarchical_score"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "configuration_sha256": {"$ref": "#/$defs/sha256"}, "hierarchical_score": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}

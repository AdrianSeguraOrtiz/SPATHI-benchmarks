{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/efficiency-component-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract", "budget", "analysis_role", "selected_config", "scout_metrics", "scout_execution_state", "selection_rule", "candidate_results", "component_nominees", "selection_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "spathi_efficiency_component_selection"},
    "contract": {"$ref": "#/$defs/reference"},
    "budget": {"enum": ["reduced", "full"]},
    "analysis_role": {"enum": ["descriptive", "selection"]},
    "selected_config": {"$ref": "#/$defs/reference"},
    "scout_metrics": {"$ref": "#/$defs/reference"},
    "scout_execution_state": {"$ref": "#/$defs/reference"},
    "selection_rule": {"type": "object"},
    "candidate_results": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/result"}},
    "component_nominees": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/nominee"}},
    "selection_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "component", "mean_aupr_loss", "wall_time_ratio", "complete", "accuracy_eligible", "dataset_count", "accuracy_seed_count", "timing_seed_count"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "component": {"enum": ["target_eligibility", "adaptive_trees"]},
        "mean_aupr_loss": {"type": "number"},
        "wall_time_ratio": {"type": "number", "exclusiveMinimum": 0},
        "complete": {"const": true},
        "accuracy_eligible": {"type": "boolean"},
        "dataset_count": {"type": "integer", "minimum": 1},
        "accuracy_seed_count": {"const": 1},
        "timing_seed_count": {"const": 1}
      }
    },
    "nominee": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "component", "execution_overrides", "scout_result", "candidate_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "component": {"enum": ["target_eligibility", "adaptive_trees"]},
        "execution_overrides": {"type": "object", "minProperties": 1},
        "scout_result": {"$ref": "#/$defs/result"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

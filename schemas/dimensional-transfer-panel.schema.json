{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/dimensional-transfer-panel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "seed_plan",
    "claim_scope",
    "design",
    "conditions",
    "feasibility_basis"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "description": {"type": "string", "minLength": 1},
    "seed_plan": {"$ref": "#/$defs/path"},
    "claim_scope": {"const": "truth_bearing_synthetic_dimensional_transfer"},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_shape",
        "cell_levels",
        "gene_levels",
        "tf_levels",
        "edges_per_target",
        "technical_noise",
        "dynamic_group_truth",
        "target_list_supplied_to_inference",
        "policy_stage",
        "selection_feedback",
        "confirmatory_ranking_eligible",
        "external_comparison_use"
      ],
      "properties": {
        "design_shape": {"const": "two_anchors_three_one_axis_scale_contrasts_and_two_routing_controls"},
        "cell_levels": {"const": [300, 500, 10000]},
        "gene_levels": {
          "const": [100, 3000, 15000]
        },
        "tf_levels": {
          "const": [10, 100, 1500]
        },
        "edges_per_target": {"const": 2},
        "technical_noise": {"const": "umi"},
        "dynamic_group_truth": {"const": true},
        "target_list_supplied_to_inference": {"const": false},
        "policy_stage": {"const": "post_calibration_freeze"},
        "selection_feedback": {"const": false},
        "confirmatory_ranking_eligible": {"const": false},
        "external_comparison_use": {"const": "forbidden"}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/condition"}
    },
    "feasibility_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_policy", "endpoint_admission", "joint_condition_rule"],
      "properties": {
        "execution_policy": {"const": "portable_machine_resolved"},
        "endpoint_admission": {"type": "string", "minLength": 1},
        "joint_condition_rule": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "analysis_role",
        "expected_group_contexts",
        "genes",
        "transcription_factors",
        "cells",
        "group_sizes",
        "targets_in_regulatory_core",
        "scenario",
        "runs",
        "replicates"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "analysis_role": {
          "enum": [
            "scale_anchor",
            "scale_endpoint",
            "single_group_routing_control",
            "extreme_group_imbalance_control"
          ]
        },
        "expected_group_contexts": {"enum": [1, 3]},
        "genes": {"enum": [100, 3000, 15000]},
        "transcription_factors": {"enum": [10, 100, 1500]},
        "cells": {"enum": [300, 500, 10000]},
        "group_sizes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 1}
        },
        "targets_in_regulatory_core": {"enum": [50, 1000]},
        "scenario": {"$ref": "#/$defs/path"},
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["full"],
          "properties": {
            "reduced": {"$ref": "#/$defs/path"},
            "full": {"$ref": "#/$defs/path"}
          }
        },
        "replicates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["full"],
          "properties": {
            "reduced": {"const": 1},
            "full": {"enum": [1, 3]}
          }
        }
      }
    }
  }
}

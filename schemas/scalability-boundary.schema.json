{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi-benchmarks.local/schemas/scalability-boundary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "decision_scope", "resource_telemetry", "forbidden_decision_inputs", "target_scout", "resource_boundary", "panels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"const": "spathi_scalability_boundary_v1"},
    "decision_scope": {"const": "computational_resources_only"},
    "resource_telemetry": {"const": "andrea_canonical_execution_telemetry"},
    "forbidden_decision_inputs": {
      "const": ["ground_truth", "accuracy_metric", "network_edges", "expression_values"]
    },
    "target_scout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "salt", "hash_coordinates", "sizes"],
      "properties": {
        "method": {"const": "sha256_gene_id"},
        "salt": {"const": "spathi-scalability-scout-v1"},
        "hash_coordinates": {"const": ["random_seed", "dataset_id", "gene_id"]},
        "sizes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reduced", "full"],
          "properties": {
            "reduced": {"const": 64},
            "full": {"const": 128}
          }
        }
      }
    },
    "resource_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_measurement", "wall_time_limit_seconds", "maximum_projected_wall_time_fraction", "maximum_observed_memory_fraction", "terminal_statuses"],
      "properties": {
        "wall_time_measurement": {"const": "andrea_execution.wall_time_seconds"},
        "wall_time_limit_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reduced", "full"],
          "properties": {
            "reduced": {"const": 43200},
            "full": {"const": 86400}
          }
        },
        "maximum_projected_wall_time_fraction": {"const": 0.8},
        "maximum_observed_memory_fraction": {"const": 0.8},
        "terminal_statuses": {"const": ["oom", "timeout", "tool_error"]}
      }
    },
    "panels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduced", "full"],
      "properties": {
        "reduced": {"$ref": "#/$defs/panel"},
        "full": {"$ref": "#/$defs/panel"}
      }
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ids", "lanes"],
      "properties": {
        "dataset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "ordered_dataset_ids"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "ordered_dataset_ids": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

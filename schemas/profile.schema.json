{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "purpose",
    "description",
    "generation_jobs",
    "inference_batches",
    "execution_class",
    "planned_design",
    "statistics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["runnable", "planned"]},
    "purpose": {
      "enum": ["smoke", "calibration", "selection", "regression", "benchmark", "scalability", "dimensional_transfer", "performance"]
    },
    "calibration_budget": {"enum": ["full", "reduced"]},
    "calibration_stage": {
      "enum": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence", "validation"]
    },
    "calibration_fidelity": {"enum": ["scout", "confirmation", "final"]},
    "selected_config": {"$ref": "#/$defs/relative_path"},
    "materialization_manifest": {"$ref": "#/$defs/relative_path"},
    "description": {"type": "string", "minLength": 1},
    "generation_jobs": {
      "type": "array",
      "items": {"$ref": "#/$defs/generation_job"}
    },
    "inference_batches": {
      "type": "array",
      "items": {"$ref": "#/$defs/inference_batch"}
    },
    "execution_class": {
      "enum": [
        "bulk_canonical",
        "bulk_full",
        "performance_full",
        "scale_canonical",
        "scale_full",
        "smoke_full"
      ]
    },
    "planned_design": {"$ref": "#/$defs/planned_design"},
    "statistics": {"$ref": "#/$defs/statistics"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "runnable"},
          "purpose": {"not": {"enum": ["scalability", "dimensional_transfer"]}}
        },
        "required": ["status", "purpose"]
      },
      "then": {
        "properties": {
          "generation_jobs": {"minItems": 1},
          "inference_batches": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"purpose": {"enum": ["calibration", "selection"]}},
        "required": ["purpose"]
      },
      "then": {"required": ["calibration_budget"]},
      "else": {"not": {"required": ["calibration_budget"]}}
    },
    {
      "if": {
        "properties": {
          "status": {"const": "runnable"},
          "purpose": {"enum": ["calibration", "selection"]}
        },
        "required": ["status", "purpose"]
      },
      "then": {"required": ["calibration_stage", "calibration_fidelity"]}
    },
    {
      "if": {"properties": {"purpose": {"const": "selection"}}, "required": ["purpose"]},
      "then": {"properties": {"calibration_stage": {"const": "validation"}, "calibration_fidelity": {"const": "final"}}}
    },
    {
      "if": {"properties": {"calibration_stage": {"enum": ["geometry", "estimator", "interaction", "estimator_scale_transfer"]}}, "required": ["calibration_stage"]},
      "then": {"properties": {"calibration_fidelity": {"enum": ["scout", "confirmation"]}}}
    },
    {
      "if": {"properties": {"calibration_stage": {"const": "convergence"}}, "required": ["calibration_stage"]},
      "then": {
        "properties": {
          "calibration_fidelity": {"const": "final"},
          "inference_batches": {
            "items": {"required": ["convergence_plans"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"purpose": {"const": "calibration"}},
        "required": ["purpose"]
      },
      "then": {
        "properties": {
          "calibration_stage": {"enum": ["geometry", "estimator", "interaction", "estimator_scale_transfer", "convergence"]},
          "calibration_fidelity": {"enum": ["scout", "confirmation", "final"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "runnable"},
          "purpose": {"enum": ["regression", "benchmark"]}
        },
        "required": ["status", "purpose"]
      },
      "then": {"required": ["selected_config", "materialization_manifest"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "generation_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dataset_role",
        "split_id",
        "condition_id"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scenario": {"$ref": "#/$defs/relative_path"},
        "simulator_runs": {"$ref": "#/$defs/relative_path"},
        "generator_request": {"$ref": "#/$defs/relative_path"},
        "dataset_role": {
          "enum": ["smoke", "development", "validation", "test", "scalability", "dimensional_transfer", "performance"]
        },
        "split_id": {"$ref": "#/$defs/id"},
        "condition_id": {"$ref": "#/$defs/id"}
      },
      "oneOf": [
        {
          "required": ["scenario", "simulator_runs"],
          "not": {"required": ["generator_request"]}
        },
        {
          "required": ["generator_request"],
          "not": {"anyOf": [{"required": ["scenario"]}, {"required": ["simulator_runs"]}]}
        }
      ]
    },
    "inference_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "dataset_role",
        "regime",
        "tools_params",
        "run_metadata"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["baseline", "spathi"]},
        "dataset_role": {
          "enum": ["smoke", "development", "validation", "test", "scalability", "dimensional_transfer", "performance"]
        },
        "generation_jobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "replicate_indices": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "regime": {
          "enum": ["group_only", "order_aware", "prior_assisted"]
        },
        "tools_params": {"$ref": "#/$defs/relative_path"},
        "custom_tools": {"$ref": "#/$defs/relative_path"},
        "calibration_manifest": {"$ref": "#/$defs/relative_path"},
        "convergence_plans": {"$ref": "#/$defs/relative_path"},
        "run_metadata": {"$ref": "#/$defs/relative_path"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "spathi"}}},
          "then": {"required": ["custom_tools"]},
          "else": {"not": {"required": ["custom_tools"]}}
        }
      ]
    },
    "planned_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulators", "replicates_per_condition", "regimes", "factors", "notes"],
      "properties": {
        "simulators": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "replicates_per_condition": {"type": "integer", "minimum": 1},
        "replicate_exceptions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "regimes": {
          "type": "array",
          "items": {
            "enum": ["group_only", "order_aware", "prior_assisted"]
          },
          "uniqueItems": true
        },
        "factors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "comparisons"
      ],
      "properties": {
        "status": {"enum": ["inferential", "descriptive", "not_applicable"]},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
        "random_seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "seed_derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "stream", "coordinates"],
          "properties": {
            "namespace": {
              "type": "string",
              "const": "full.test"
            },
            "stream": {"const": "statistical"},
            "coordinates": {"const": {"purpose": "phase_root"}}
          }
        },
        "permutations": {"type": "integer", "minimum": 9999, "maximum": 9999999},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000, "maximum": 1000000},
        "comparisons": {
          "type": "array",
          "items": {"$ref": "#/$defs/statistical_comparison"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "inferential"}}, "required": ["status"]},
          "then": {
            "required": ["alpha", "random_seed", "seed_derivation", "permutations", "bootstrap_resamples"],
            "properties": {
              "comparisons": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/statistical_comparison"},
                    {"required": ["posthoc_scope", "correction"]}
                  ]
                }
              }
            }
          },
          "else": {
            "if": {"properties": {"status": {"const": "descriptive"}}, "required": ["status"]},
            "then": {
              "properties": {
                "comparisons": {
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {"$ref": "#/$defs/statistical_comparison"},
                      {"properties": {"comparison_role": {"const": "exploratory"}}},
                      {
                        "not": {
                          "anyOf": [
                            {"required": ["posthoc_scope"]},
                            {"required": ["correction"]}
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              "not": {
                "anyOf": [
                  {"required": ["alpha"]},
                  {"required": ["random_seed"]},
                  {"required": ["seed_derivation"]},
                  {"required": ["permutations"]},
                  {"required": ["bootstrap_resamples"]}
                ]
              }
            },
            "else": {
              "properties": {"comparisons": {"maxItems": 0}},
              "not": {
                "anyOf": [
                  {"required": ["alpha"]},
                  {"required": ["random_seed"]},
                  {"required": ["seed_derivation"]},
                  {"required": ["permutations"]},
                  {"required": ["bootstrap_resamples"]}
                ]
              }
            }
          }
        }
      ]
    },
    "statistical_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "comparison_role",
        "analysis_kind",
        "truth_scope",
        "aggregation",
        "candidate_space",
        "inference_regulator_scope_by_configuration",
        "dataset_roles",
        "regime",
        "levels",
        "metrics",
        "primary_level",
        "primary_metric",
        "configuration_ids",
        "algorithm_seeds_by_configuration",
        "control_configuration_id",
        "stratify_by",
        "expected_blocks"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "comparison_role": {"enum": ["confirmatory", "exploratory"]},
        "analysis_kind": {"enum": ["network_accuracy", "invariant_network_stability"]},
        "truth_scope": {"enum": ["group_specific", "invariant"]},
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_unit", "hierarchy", "weighting"],
          "properties": {
            "block_unit": {"const": "dataset_id"},
            "hierarchy": {
              "const": ["simulator_id", "condition_id", "dataset_id"]
            },
            "weighting": {"const": "equal_dataset"}
          }
        },
        "candidate_space": {
          "description": "Candidate edge universe used by ANDREA evaluation after projecting every inferred network to the ground-truth contract.",
          "enum": ["tf_restricted", "all_gene"]
        },
        "inference_regulator_scope_by_configuration": {
          "description": "Regulator search space exposed to each inference configuration before the common ANDREA evaluation projection.",
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"enum": ["tf_restricted", "all_gene"]}
        },
        "dataset_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["smoke", "development", "validation", "test", "scalability", "dimensional_transfer", "performance"]
          }
        },
        "generation_jobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "regime": {
          "enum": ["group_only", "order_aware", "prior_assisted"]
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["directed", "topology", "signed"]}
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "auroc",
              "aupr",
              "f1_at_truth_count",
              "epr_at_truth_count",
              "invariant_edge_stability"
            ]
          }
        },
        "primary_level": {"enum": ["directed", "topology", "signed"]},
        "primary_metric": {
          "enum": [
            "auroc",
            "aupr",
            "f1_at_truth_count",
            "epr_at_truth_count",
            "invariant_edge_stability"
          ]
        },
        "configuration_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "algorithm_seeds_by_configuration": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1, "maximum": 2147483646}
              },
              {"const": [null]}
            ]
          }
        },
        "control_configuration_id": {"$ref": "#/$defs/id"},
        "stratify_by": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dataset_role",
              "split_id",
              "condition_id",
              "simulator_id",
              "generation_job",
              "regime",
              "level"
            ]
          },
          "allOf": [
            {"contains": {"const": "dataset_role"}},
            {"contains": {"const": "regime"}},
            {"contains": {"const": "level"}}
          ]
        },
        "expected_blocks": {"type": "integer", "minimum": 1},
        "posthoc_scope": {"const": "control_vs_rest"},
        "correction": {"const": "holm"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"analysis_kind": {"const": "network_accuracy"}},
            "required": ["analysis_kind"]
          },
          "then": {
            "properties": {
              "primary_metric": {
                "enum": ["auroc", "aupr", "f1_at_truth_count", "epr_at_truth_count"]
              },
              "metrics": {
                "not": {"contains": {"const": "invariant_edge_stability"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"analysis_kind": {"const": "invariant_network_stability"}},
            "required": ["analysis_kind"]
          },
          "then": {
            "properties": {
              "comparison_role": {"const": "exploratory"},
              "truth_scope": {"const": "invariant"},
              "primary_level": {"const": "directed"},
              "primary_metric": {"const": "invariant_edge_stability"},
              "metrics": {"contains": {"const": "invariant_edge_stability"}}
            }
          }
        },
        {
          "if": {
            "properties": {"comparison_role": {"const": "confirmatory"}},
            "required": ["comparison_role"]
          },
          "then": {
            "properties": {
              "analysis_kind": {"const": "network_accuracy"},
              "truth_scope": {"const": "group_specific"}
            }
          }
        }
      ]
    }
  }
}

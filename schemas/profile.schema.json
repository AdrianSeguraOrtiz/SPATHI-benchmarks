{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spathi.dev/benchmarks/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "purpose",
    "description",
    "generation_jobs",
    "inference_batches",
    "resources",
    "planned_design",
    "statistics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["runnable", "planned"]},
    "purpose": {"enum": ["smoke", "calibration", "selection", "regression", "benchmark"]},
    "description": {"type": "string", "minLength": 1},
    "generation_jobs": {
      "type": "array",
      "items": {"$ref": "#/$defs/generation_job"}
    },
    "inference_batches": {
      "type": "array",
      "items": {"$ref": "#/$defs/inference_batch"}
    },
    "resources": {"$ref": "#/$defs/resources"},
    "planned_design": {"$ref": "#/$defs/planned_design"},
    "statistics": {"$ref": "#/$defs/statistics"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "runnable"}}},
      "then": {
        "properties": {
          "generation_jobs": {"minItems": 1},
          "inference_batches": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "generation_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "simulator_runs",
        "dataset_role",
        "split_id",
        "condition_id"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scenario": {"$ref": "#/$defs/relative_path"},
        "simulator_runs": {"$ref": "#/$defs/relative_path"},
        "dataset_role": {"enum": ["smoke", "development", "validation", "test"]},
        "split_id": {"$ref": "#/$defs/id"},
        "condition_id": {"$ref": "#/$defs/id"}
      }
    },
    "inference_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "dataset_role",
        "regime",
        "tools_params",
        "run_metadata"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["baseline", "spathi"]},
        "dataset_role": {"enum": ["smoke", "development", "validation", "test"]},
        "regime": {
          "enum": ["group_only", "order_aware", "pseudotime_aware", "prior_assisted"]
        },
        "tools_params": {"$ref": "#/$defs/relative_path"},
        "custom_tools": {"$ref": "#/$defs/relative_path"},
        "calibration_manifest": {"$ref": "#/$defs/relative_path"},
        "run_metadata": {"$ref": "#/$defs/relative_path"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "spathi"}}},
          "then": {"required": ["custom_tools"]},
          "else": {"not": {"required": ["custom_tools"]}}
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generate_data", "infer_network"],
      "properties": {
        "generate_data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_parallel_tasks", "max_cores", "max_ram_gb"],
          "properties": {
            "max_parallel_tasks": {"type": "integer", "minimum": 1},
            "max_cores": {"type": "integer", "minimum": 1},
            "max_ram_gb": {"type": "number", "minimum": 1}
          }
        },
        "infer_network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_parallel_runs",
            "max_cores",
            "max_ram_gb",
            "planner",
            "planner_time_limit_seconds"
          ],
          "properties": {
            "max_parallel_runs": {"type": "integer", "minimum": 1},
            "max_cores": {"type": "integer", "minimum": 1},
            "max_ram_gb": {"type": "number", "minimum": 1},
            "planner": {"enum": ["auto", "cp_sat", "heuristic"]},
            "planner_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "planned_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulators", "replicates_per_condition", "regimes", "factors", "notes"],
      "properties": {
        "simulators": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "replicates_per_condition": {"type": "integer", "minimum": 1},
        "regimes": {
          "type": "array",
          "items": {
            "enum": ["group_only", "order_aware", "pseudotime_aware", "prior_assisted"]
          },
          "uniqueItems": true
        },
        "factors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "alpha",
        "random_seed",
        "permutations",
        "bootstrap_resamples",
        "comparisons"
      ],
      "properties": {
        "status": {"enum": ["enabled", "planned"]},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
        "random_seed": {"type": "integer", "minimum": 0},
        "permutations": {"type": "integer", "minimum": 9999, "maximum": 9999999},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000, "maximum": 1000000},
        "comparisons": {
          "type": "array",
          "items": {"$ref": "#/$defs/statistical_comparison"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "enabled"}}},
          "then": {"properties": {"comparisons": {"minItems": 1}}},
          "else": {"properties": {"comparisons": {"maxItems": 0}}}
        }
      ]
    },
    "statistical_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "comparison_role",
        "candidate_space",
        "dataset_roles",
        "regime",
        "levels",
        "metrics",
        "primary_level",
        "primary_metric",
        "configuration_ids",
        "control_configuration_id",
        "stratify_by",
        "min_blocks",
        "posthoc_scope",
        "correction"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "comparison_role": {"enum": ["confirmatory", "exploratory"]},
        "candidate_space": {"enum": ["tf_restricted", "all_gene"]},
        "dataset_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["smoke", "development", "validation", "test"]}
        },
        "regime": {
          "enum": ["group_only", "order_aware", "pseudotime_aware", "prior_assisted"]
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["directed", "topology", "signed"]}
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["auroc", "aupr", "f1_at_truth_count", "epr_at_truth_count"]
          }
        },
        "primary_level": {"enum": ["directed", "topology", "signed"]},
        "primary_metric": {
          "enum": ["auroc", "aupr", "f1_at_truth_count", "epr_at_truth_count"]
        },
        "configuration_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "control_configuration_id": {"$ref": "#/$defs/id"},
        "stratify_by": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dataset_role",
              "split_id",
              "condition_id",
              "simulator_id",
              "generation_job",
              "regime",
              "level"
            ]
          },
          "allOf": [
            {"contains": {"const": "dataset_role"}},
            {"contains": {"const": "regime"}},
            {"contains": {"const": "level"}}
          ]
        },
        "min_blocks": {"type": "integer", "minimum": 2},
        "posthoc_scope": {"const": "control_vs_rest"},
        "correction": {"const": "holm"}
      }
    }
  }
}

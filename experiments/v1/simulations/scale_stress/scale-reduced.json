{
  "schema_version": "1.0",
  "id": "scale_stress_reduced_v1",
  "description": "Low-cost operational scale-stress panel on a rounded, author-defined public synthetic grid selected to cover the intended application-scale envelope without retaining source samples, identifiers, exact dimensions or biological observations.",
  "seed_plan": "experiments/v1/seeds/seed-plan.json",
  "scale_grid": {
    "provenance": "author_defined_public_synthetic_grid",
    "cells": [1000, 3000],
    "genes": [5000, 10000],
    "transcription_factors": [250, 500]
  },
  "expression_preparation": {
    "input_scale": "nonnegative_synthetic_counts_like",
    "normalization": "library-size-log1p",
    "target_sum": 10000.0,
    "library_size_scope": "all_generated_genes_before_any_filtering",
    "formula": "log1p(target_sum * raw_value / per_cell_library_size)"
  },
  "datasets": [
    {
      "id": "scale_stress_reduced_baseline",
      "design_role": {"kind": "synthetic_scale_case", "case_id": "reduced_baseline", "purpose": "Exercise a rounded multi-group baseline with modest development cost."},
      "seed": 887098426,
      "seed_derivation": {"namespace": "reduced.scalability", "stream": "augmentation", "coordinates": {"phase": "scalability", "dataset_id": "scale_stress_reduced_baseline", "augmentation_contract": "scale_stress_v1"}},
      "genes": 5000,
      "tfs": 250,
      "groups": [{"id": "state_1", "cells": 200}, {"id": "state_2", "cells": 300}, {"id": "state_3", "cells": 500}],
      "network_mode": "dynamic",
      "active_tf_fraction": 0.75,
      "regulated_target_fraction": 0.85,
      "low_detection_target_fraction": 0.15,
      "regulators_per_target": 3,
      "rewiring_fraction": 0.34,
      "base_dropout_probability": 0.65,
      "low_detection_dropout_probability": 0.93,
      "library_size_log_sd": 0.45,
      "latent_factors": 6,
      "noise_sd": 0.25
    },
    {
      "id": "scale_stress_reduced_moderate",
      "design_role": {"kind": "synthetic_scale_case", "case_id": "reduced_moderate", "purpose": "Exercise a larger rounded multi-group workload while remaining suitable for development."},
      "seed": 1435037678,
      "seed_derivation": {"namespace": "reduced.scalability", "stream": "augmentation", "coordinates": {"phase": "scalability", "dataset_id": "scale_stress_reduced_moderate", "augmentation_contract": "scale_stress_v1"}},
      "genes": 10000,
      "tfs": 500,
      "groups": [{"id": "state_1", "cells": 300}, {"id": "state_2", "cells": 900}, {"id": "state_3", "cells": 1800}],
      "network_mode": "dynamic",
      "active_tf_fraction": 0.75,
      "regulated_target_fraction": 0.85,
      "low_detection_target_fraction": 0.15,
      "regulators_per_target": 3,
      "rewiring_fraction": 0.34,
      "base_dropout_probability": 0.65,
      "low_detection_dropout_probability": 0.92,
      "library_size_log_sd": 0.45,
      "latent_factors": 6,
      "noise_sd": 0.25
    }
  ]
}

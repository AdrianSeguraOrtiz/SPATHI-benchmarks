  "planned_design": {
    "simulators": ["dyngen", "scmultisim", "sergio", "boolode", "genespider2"],
    "replicates_per_condition": 5,
    "regimes": ["group_only", "order_aware", "pseudotime_aware"],
    "factors": [
      "topology",
      "cell_and_gene_scale",
      "kinetics_noise",
      "technical_noise",
      "dropout",
      "population_imbalance_and_small_groups",
      "dynamic_rewiring",
      "invariant_network_control"
    ],
    "notes": [
      "Contains 50 held-out datasets: 20 dyngen, ten scMultiSim, five SERGIO, ten BoolODE and five GeneSPIDER2 instances.",
      "Dyngen conditions span 200 to 500 cells and 70 to 130 genes; other simulators add distinct 80- and 100-gene geometries.",
      "scMultiSim crosses low balanced rewiring with high rewiring, UMI noise and a 12-cell minority population.",
      "BoolODE crosses clean and explicit dropout-processed invariant-network controls.",
      "Test seeds are never used for calibration or finalist selection.",
      "Prior-assisted routes stay excluded until a non-leaky, separately fingerprinted prior dataset is defined.",
      "SERGIO, BoolODE and GeneSPIDER2 provide invariant group truth for ordinary accuracy metrics; v1 does not claim an explicit rewiring-distance endpoint.",
      "The scMultiSim test topology is independent of development and validation and is shared only across the two predeclared test stress conditions."
    ]
  },
  "statistics": {
    "status": "planned",
    "alpha": 0.05,
    "random_seed": 1729,
    "permutations": 99999,

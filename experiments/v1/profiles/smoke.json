{
  "schema_version": "1.0",
  "id": "smoke",
  "status": "runnable",
  "purpose": "smoke",
  "description": "Contract-level dyngen benchmark with GENIE3 and SPATHI.",
  "generation_jobs": [
    {
      "id": "dyngen_smoke",
      "scenario": "experiments/v1/simulations/dyngen/scenario.json",
      "simulator_runs": "experiments/v1/simulations/dyngen/smoke-runs.json",
      "dataset_role": "smoke",
      "split_id": "smoke",
      "condition_id": "contract"
    }
  ],
  "inference_batches": [
    {
      "id": "group_only_baseline",
      "kind": "baseline",
      "dataset_role": "smoke",
      "regime": "group_only",
      "tools_params": "experiments/v1/inference/group_only/smoke-baselines.json",
      "run_metadata": "experiments/v1/inference/group_only/smoke-baselines-metadata.json"
    },
    {
      "id": "group_only_spathi_smoke",
      "kind": "spathi",
      "dataset_role": "smoke",
      "regime": "group_only",
      "tools_params": "experiments/v1/spathi/smoke-tools-params.json",
      "custom_tools": "experiments/v1/spathi/smoke-custom-tools.json",
      "run_metadata": "experiments/v1/spathi/smoke-run-metadata.json"
    }
  ],
  "resources": {
    "generate_data": {
      "max_parallel_tasks": 1,
      "max_cores": 2,
      "max_ram_gb": 8
    },
    "infer_network": {
      "max_parallel_runs": 1,
      "max_cores": 2,
      "max_ram_gb": 8,
      "planner": "heuristic",
      "planner_time_limit_seconds": 30
    }
  },
  "planned_design": {
    "simulators": ["dyngen"],
    "replicates_per_condition": 1,
    "regimes": ["group_only"],
    "factors": ["end-to-end contract"],
    "notes": ["This profile is a software smoke test, not an inferential study."]
  },
  "statistics": {
    "status": "enabled",
    "alpha": 0.05,
    "random_seed": 1729,
    "permutations": 99999,
    "bootstrap_resamples": 20000,
    "comparisons": [
      {
        "id": "group_only_tf_restricted",
        "comparison_role": "confirmatory",
        "candidate_space": "tf_restricted",
        "dataset_roles": ["smoke"],
        "regime": "group_only",
        "levels": ["directed", "topology"],
        "metrics": ["aupr", "auroc", "f1_at_truth_count", "epr_at_truth_count"],
        "primary_level": "directed",
        "primary_metric": "aupr",
        "configuration_ids": ["genie3_smoke", "spathi_smoke"],
        "control_configuration_id": "spathi_smoke",
        "stratify_by": [
          "dataset_role",
          "split_id",
          "condition_id",
          "simulator_id",
          "generation_job",
          "regime",
          "level"
        ],
        "min_blocks": 8,
        "posthoc_scope": "control_vs_rest",
        "correction": "holm"
      }
    ]
  }
}

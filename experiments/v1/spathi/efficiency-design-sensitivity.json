{
  "schema_version": "1.0",
  "id": "spathi_efficiency_design_sensitivity_v1",
  "status": "predeclared",
  "timing": "before_full_efficiency_outcomes",
  "study_path": "experiments/v1/spathi/efficiency-study.json",
  "budget": "full",
  "purpose": "Describe the operating characteristics of the frozen full efficiency design over explicit nuisance-variance scenarios without using efficiency outcomes.",
  "interpretation": "prospective_assumption_conditional_operating_characteristics_not_an_empirical_power_guarantee",
  "method": {
    "id": "closed_form_normal_location_sensitivity",
    "random_sampling": false,
    "familywise_alpha": 0.05,
    "confirmatory_candidate_count": 1,
    "per_candidate_one_sided_alpha": 0.05,
    "weighting": "equal_simulator_equal_condition_equal_dataset",
    "assumptions": [
      "Independent generation seeds within each fixed simulator-condition stratum.",
      "A common within-stratum standard deviation for each scenario.",
      "A normal location approximation for the weighted paired estimator.",
      "The fixed five-seed algorithm ensemble is averaged before dataset-level inference.",
      "The calculation approximates design sensitivity and does not validate small-sample percentile-bootstrap coverage."
    ]
  },
  "target_design": {
    "profile": "efficiency-full",
    "expected_independent_datasets": 25,
    "expected_effective_sample_size": 16.0,
    "strata": [
      {
        "generation_job": "dyngen_efficiency_linear_baseline",
        "simulator_id": "dyngen",
        "condition_id": "linear_baseline",
        "replicates": 5
      },
      {
        "generation_job": "dyngen_efficiency_linear_noisy",
        "simulator_id": "dyngen",
        "condition_id": "linear_noisy",
        "replicates": 5
      },
      {
        "generation_job": "dyngen_efficiency_bifurcating_baseline",
        "simulator_id": "dyngen",
        "condition_id": "bifurcating_baseline",
        "replicates": 5
      },
      {
        "generation_job": "dyngen_efficiency_bifurcating_noisy",
        "simulator_id": "dyngen",
        "condition_id": "bifurcating_noisy",
        "replicates": 5
      },
      {
        "generation_job": "scmultisim_efficiency_dynamic",
        "simulator_id": "scmultisim",
        "condition_id": "scmultisim_dynamic",
        "replicates": 5
      }
    ]
  },
  "scenario_grid": {
    "accuracy": {
      "estimand": "mean_candidate_minus_reference_absolute_aupr",
      "noninferiority_margin": 0.002,
      "true_mean_differences": [-0.006, -0.004, -0.002, 0.0, 0.002],
      "within_stratum_standard_deviations": [0.001, 0.002, 0.005, 0.01, 0.02]
    },
    "runtime": {
      "estimand": "hierarchical_geometric_mean_candidate_over_reference_ratio",
      "maximum_ratio": 1.0,
      "true_geometric_mean_ratios": [0.5, 0.65, 0.8, 0.9, 1.0, 1.1],
      "within_stratum_log_standard_deviations": [0.02, 0.05, 0.1, 0.2, 0.4]
    }
  },
  "reporting": {
    "accuracy_probability": "probability_that_the_approximate_one_sided_lower_bound_meets_the_margin",
    "runtime_probability": "probability_that_the_approximate_one_sided_upper_bound_is_below_one",
    "required_caveat": "These probabilities are conditional on each declared normal-variance scenario and are not empirical power estimates for the unknown outcome distribution."
  }
}

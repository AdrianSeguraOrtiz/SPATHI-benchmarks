{
  "tools": [
    {
      "run_id": "spathi_smoke",
      "name": "SPATHI smoke",
      "docker_image": "spathi-benchmarks/spathi:c4e91f4a",
      "execution_mode": "group_native",
      "extra_inputs": ["groups", "tf_list"],
      "outputs": {
        "directed": true,
        "sign": "none"
      },
      "runtime_resources": {
        "threading": {
          "supported": true,
          "default_threads": 1,
          "max_threads": null,
          "upstream_mapping": "cli:--threads"
        }
      }
    }
  ]
}

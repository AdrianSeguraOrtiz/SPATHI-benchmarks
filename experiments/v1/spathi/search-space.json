  "stages": [
    {
      "id": "geometry",
      "order": 1,
      "dataset_role": "development",
      "purpose": "Compare a bounded set of biologically meaningful distance geometries, including joint choices that a one-factor search cannot identify.",
      "inherits_from": "base_configuration",
      "strategy": "bounded_constrained_design",
      "dataset_selector": {"split_id": "development_v1", "condition_ids": ["linear_baseline", "linear_noisy", "bifurcating_baseline", "bifurcating_noisy", "scmultisim_dynamic", "scmultisim_imbalanced", "scmultisim_single_group"]},
      "include_inherited_configuration": true,
      "maximum_parent_configurations": 1,
      "candidate_budget_per_parent": 16,
      "candidates": [
        {"id": "pca50_none_cosine_gaussian_anchored_cap_solver_full", "parameter_overrides": {"pca_svd_solver": "full"}, "rationale": "Measure the exact full-SVD geometry rather than assuming it is interchangeable with the automatic solver."},
        {"id": "pca50_none_cosine_gaussian_anchored_cap_solver_randomized", "parameter_overrides": {"pca_svd_solver": "randomized"}, "rationale": "Measure the randomized truncated-SVD geometry because numerical approximation can change downstream distances and accuracy."},
        {"id": "pca20_standard_euclidean_gaussian_anchored_cap", "parameter_overrides": {"n_components": 20, "distance_standardization": "standard", "distance_metric": "euclidean"}, "rationale": "Evaluate a compact standardized PCA geometry."},
        {"id": "pca100_none_euclidean_gaussian_anchored_cap", "parameter_overrides": {"n_components": 100, "distance_metric": "euclidean"}, "rationale": "Retain more expression variation in an alternative Euclidean geometry when dataset rank permits it."},
        {"id": "pca50_standard_cosine_gaussian_anchored_cap", "parameter_overrides": {"distance_standardization": "standard", "distance_metric": "cosine"}, "rationale": "Test the interaction between standardization and angular distance."},
        {"id": "expression_none_cosine_exponential_anchored_cap", "parameter_overrides": {"distance_space": "expression", "distance_metric": "cosine", "kernel": "exponential"}, "rationale": "Test a joint expression-space angular geometry with the exponential kernel."},
        {"id": "expression_standard_euclidean_gaussian_anchored_cap", "parameter_overrides": {"distance_space": "expression", "distance_standardization": "standard", "distance_metric": "euclidean"}, "rationale": "Compare standardized full-expression distances with PCA distances."},
        {"id": "pca50_none_euclidean_exponential_anchored_cap", "parameter_overrides": {"distance_metric": "euclidean", "kernel": "exponential"}, "rationale": "Test the supported exponential kernel in an alternative Euclidean PCA geometry."},
        {"id": "pca50_none_cosine_gaussian_anchored_cap_bandwidth_half", "parameter_overrides": {"bandwidth_scale": 0.5}, "rationale": "Test faster distance decay at one half of the dataset-adaptive bandwidth."},
        {"id": "pca50_none_cosine_gaussian_anchored_cap_bandwidth_double", "parameter_overrides": {"bandwidth_scale": 2.0}, "rationale": "Test slower distance decay at twice the dataset-adaptive bandwidth."},
        {"id": "pca50_none_cosine_gaussian_cell_none", "parameter_overrides": {"weight_mode": "cell-distance", "group_size_correction": "none"}, "rationale": "Test cell-to-centroid weights without group anchoring."},
        {"id": "pca50_none_cosine_gaussian_cell_cap", "parameter_overrides": {"weight_mode": "cell-distance", "group_size_correction": "cap-to-target"}, "rationale": "Estimate the interaction between cell-level distances and target-group size correction."},
        {"id": "pca50_none_cosine_gaussian_group_none", "parameter_overrides": {"weight_mode": "group-distance", "group_size_correction": "none"}, "rationale": "Test group-centroid rather than cell-level distances."},
        {"id": "pca50_none_cosine_gaussian_group_cap", "parameter_overrides": {"weight_mode": "group-distance", "group_size_correction": "cap-to-target"}, "rationale": "Estimate the interaction between group-centroid distance and target-group size correction."},
        {"id": "pca50_none_cosine_gaussian_anchored_none", "parameter_overrides": {"group_size_correction": "none"}, "rationale": "Measure the contribution of target-group size correction."}
      ],
      "advance_limit": 3
    },
    {
      "id": "estimator",
      "order": 2,
      "dataset_role": "development",
      "purpose": "Cross each retained geometry with a bounded estimator design covering feature subsampling, regularization, depth and valid bootstrap choices.",
      "inherits_from": "shortlist:geometry",
      "strategy": "bounded_crossed_shortlist",
      "dataset_selector": {"split_id": "development_v1", "condition_ids": ["linear_baseline", "linear_noisy", "bifurcating_baseline", "bifurcating_noisy", "scmultisim_dynamic", "scmultisim_imbalanced", "scmultisim_single_group", "scmultisim_medium"]},

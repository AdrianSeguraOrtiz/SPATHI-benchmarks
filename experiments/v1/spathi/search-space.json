        {"id": "extra_trees_features_log2", "parameter_overrides": {"tree_method": "extra-trees", "max_features": "log2", "bootstrap": false}, "rationale": "Use logarithmic feature subsampling with Extra-Trees."},
        {"id": "extra_trees_features_fraction_025", "parameter_overrides": {"tree_method": "extra-trees", "max_features": 0.25, "bootstrap": false}, "rationale": "Use a portable one-quarter feature fraction."},
        {"id": "extra_trees_features_fraction_050", "parameter_overrides": {"tree_method": "extra-trees", "max_features": 0.5, "bootstrap": false}, "rationale": "Use a portable one-half feature fraction."},
        {"id": "extra_trees_features_fraction_100", "parameter_overrides": {"tree_method": "extra-trees", "max_features": 1.0, "bootstrap": false}, "rationale": "Test the all-predictor endpoint, which is distinct from integer one."},
        {"id": "extra_trees_leaf_2", "parameter_overrides": {"tree_method": "extra-trees", "min_samples_leaf": 2, "bootstrap": false}, "rationale": "Introduce mild leaf regularization."},
        {"id": "extra_trees_leaf_5", "parameter_overrides": {"tree_method": "extra-trees", "min_samples_leaf": 5, "bootstrap": false}, "rationale": "Test stronger leaf regularization."},
        {"id": "extra_trees_depth_20", "parameter_overrides": {"tree_method": "extra-trees", "max_depth": 20, "bootstrap": false}, "rationale": "Bound tree depth explicitly."},
        {"id": "extra_trees_bootstrap", "parameter_overrides": {"tree_method": "extra-trees", "bootstrap": true}, "rationale": "Measure bootstrap sampling independently within Extra-Trees."},
        {"id": "random_forest_bootstrap", "parameter_overrides": {"tree_method": "random-forest", "bootstrap": true}, "rationale": "Compare the supported Random Forest family under its explicit bootstrap regime."},
        {"id": "random_forest_no_bootstrap", "parameter_overrides": {"tree_method": "random-forest", "bootstrap": false}, "rationale": "Compare Random Forest without resampling so both effective bootstrap behaviours are represented in each estimator family."}
      ],
      "advance_limit": 3
    },
